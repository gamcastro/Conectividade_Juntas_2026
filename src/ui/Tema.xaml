<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         TEMA DICON. Mesclado em $window.Resources DEPOIS dos dicionarios do
         MahApps.Metro (Dark.Blue), por New-JanelaPrincipal. Referencie tudo
         daqui por {DynamicResource ...} no MainWindow.xaml (a mescla acontece
         depois do parse do XAML da janela).
         =================================================================== -->

    <!-- ===== PALETA (tom escuro; assets/marca/paleta.md) ===== -->
    <SolidColorBrush x:Key="Dicon.Bg"         Color="#0F1319"/>
    <SolidColorBrush x:Key="Dicon.Surface"    Color="#151A22"/>
    <SolidColorBrush x:Key="Dicon.SurfaceAlt" Color="#12161D"/>
    <SolidColorBrush x:Key="Dicon.Hair"       Color="#262D39"/>
    <SolidColorBrush x:Key="Dicon.Text"       Color="#E6EAF2"/>
    <SolidColorBrush x:Key="Dicon.Text2"      Color="#AEB6C4"/>
    <SolidColorBrush x:Key="Dicon.Text3"      Color="#7D8698"/>
    <SolidColorBrush x:Key="Dicon.Accent"     Color="#6E9BFF"/>
    <SolidColorBrush x:Key="Dicon.AccentHi"   Color="#8BB0FF"/>
    <SolidColorBrush x:Key="Dicon.AccentDim"  Color="#2C3A57"/>
    <SolidColorBrush x:Key="Dicon.Deep"       Color="#0A1428"/>
    <SolidColorBrush x:Key="Dicon.Viavel"     Color="#4FC177"/>
    <SolidColorBrush x:Key="Dicon.Ressalva"   Color="#E8B93E"/>
    <SolidColorBrush x:Key="Dicon.Inviavel"   Color="#E8695C"/>
    <SolidColorBrush x:Key="Dicon.Amarelo"    Color="#F2C200"/>
    <SolidColorBrush x:Key="Dicon.Verde"      Color="#009C3B"/>
    <SolidColorBrush x:Key="Dicon.CampoBg"    Color="#0C1017"/>

    <!-- Paleta do log (fundo escuro). Em sincronia com o Log.ps1. -->
    <SolidColorBrush x:Key="LogInfo"     Color="#7FB2E8"/>
    <SolidColorBrush x:Key="LogOk"       Color="#4FC177"/>
    <SolidColorBrush x:Key="LogAviso"    Color="#E8B93E"/>
    <SolidColorBrush x:Key="LogErro"     Color="#E8695C"/>
    <SolidColorBrush x:Key="LogDestaque" Color="#E86AA6"/>
    <SolidColorBrush x:Key="LogNeutro"   Color="#5AC8D8"/>

    <!-- ===== ACENTO DO MAHAPPS reescrito para o azul-je ===== -->
    <Color x:Key="MahApps.Colors.Accent">#6E9BFF</Color>
    <Color x:Key="MahApps.Colors.Accent2">#5B8DEF</Color>
    <Color x:Key="MahApps.Colors.Accent3">#4A7CE0</Color>
    <Color x:Key="MahApps.Colors.Accent4">#3A66C2</Color>
    <Color x:Key="MahApps.Colors.Highlight">#3A66C2</Color>
    <Color x:Key="MahApps.Colors.IdealForeground">#0A1120</Color>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent"          Color="#6E9BFF"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent2"         Color="#5B8DEF"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent3"         Color="#4A7CE0"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent4"         Color="#3A66C2"/>
    <SolidColorBrush x:Key="MahApps.Brushes.AccentBase"      Color="#6E9BFF"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Highlight"       Color="#3A66C2"/>
    <SolidColorBrush x:Key="MahApps.Brushes.IdealForeground" Color="#0A1120"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Window.Background" Color="#0F1319"/>

    <!-- ===== TIPOGRAFIA =====
         Dicon.Display (Archivo) e Dicon.Body (Segoe UI) sao injetadas por
         codigo em New-JanelaPrincipal; aqui ficam so os estilos de texto. -->
    <Style x:Key="TituloTela" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Dicon.Display}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SecaoTela" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Dicon.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text2}"/>
    </Style>
    <Style x:Key="SubtituloTela" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text3}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text3}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="Dado" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
    </Style>
    <Style x:Key="TileNumero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Dicon.Display}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
    </Style>
    <Style x:Key="TileRotulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text3}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- ===== SUPERFICIES ===== -->
    <Style x:Key="Cartao" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Dicon.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Hair}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="Faixa" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Dicon.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Hair}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Background" Value="{DynamicResource Dicon.AccentDim}"/>
    </Style>

    <!-- ===== BOTOES ===== -->
    <Style x:Key="BotaoPrimario" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Deep}"/>
        <Setter Property="Background" Value="{DynamicResource Dicon.Accent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Dicon.Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dicon.AccentHi}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#5B8DEF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dicon.AccentDim}"/>
                            <Setter Property="Foreground" Value="#6B7688"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoSecundario" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
        <Setter Property="Background" Value="#232B36"/>
        <Setter Property="FontFamily" Value="{DynamicResource Dicon.Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2C3644"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dicon.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1C242E"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#5A6472"/>
                            <Setter TargetName="bd" Property="Background" Value="#1A1F27"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoFantasma" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text2}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,7"/>
    </Style>

    <Style x:Key="BotaoSucesso" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
        <Setter Property="Background" Value="{DynamicResource Dicon.Viavel}"/>
        <Setter Property="Foreground" Value="#08210F"/>
    </Style>

    <!-- ===== CAMPOS ===== -->
    <Style x:Key="Campo" TargetType="Control">
        <Setter Property="Background" Value="{DynamicResource Dicon.CampoBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Hair}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Campo}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Dicon.Accent}"/>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Campo}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Dicon.Accent}"/>
    </Style>

    <!-- ===== COMBOBOX (dark, nao editavel) ===== -->
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Dicon.AccentDim}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Dicon.AccentDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Dicon.CampoBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Hair}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                        <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="cp" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}"
                                 Margin="6,0,24,0" Padding="0" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center" Visibility="Hidden"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{TemplateBinding Foreground}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Focusable="True"/>
                        <Path x:Name="ar" Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource Dicon.Text3}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource Dicon.Surface}"
                                    BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                                    CornerRadius="4" MinWidth="{Binding ActualWidth, ElementName=bd}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="cp" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dicon.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dicon.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CHECKBOX (dark) ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text2}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="3" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                                Background="{DynamicResource Dicon.CampoBg}">
                            <Path x:Name="chk" Data="M1,5 L5,9 L11,2" Margin="2"
                                  Stroke="{DynamicResource Dicon.Deep}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Dicon.Accent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Dicon.Accent}"/>
                            <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Dicon.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== NAVEGACAO (rail) ===== -->
    <Style x:Key="NavBotao" TargetType="RadioButton">
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="6" Padding="12,10" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="mark" Grid.Column="0" Width="3" CornerRadius="2"
                                    Background="Transparent" Margin="0,1,10,1"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dicon.Surface}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dicon.AccentDim}"/>
                            <Setter TargetName="mark" Property="Background" Value="{DynamicResource Dicon.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TABELAS ===== -->
    <Style x:Key="GridMetricas" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Dicon.Surface}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Dicon.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Hair}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Dicon.Hair}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="SelectionUnit" Value="Cell"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Dicon.SurfaceAlt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text2}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Dicon.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Hair}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Dicon.AccentDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CHIP DE VEREDITO (colore conforme o texto) ===== -->
    <Style x:Key="ChipVeredito" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text3}"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="viavel">
                <Setter Property="Foreground" Value="{DynamicResource Dicon.Viavel}"/>
            </Trigger>
            <Trigger Property="Text" Value="ressalva">
                <Setter Property="Foreground" Value="{DynamicResource Dicon.Ressalva}"/>
            </Trigger>
            <Trigger Property="Text" Value="inviavel">
                <Setter Property="Foreground" Value="{DynamicResource Dicon.Inviavel}"/>
            </Trigger>
            <Trigger Property="Text" Value="viavel_com_ressalva">
                <Setter Property="Foreground" Value="{DynamicResource Dicon.Ressalva}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== MARCA DICON (simbolo em Path) ===== -->
    <PathGeometry x:Key="Dicon.EstrelaUnit"
                  Figures="M0,-1 L0.2245,-0.309 0.9511,-0.309 0.3633,0.1181 0.5878,0.809 0,0.382 -0.5878,0.809 -0.3633,0.1181 -0.9511,-0.309 -0.2245,-0.309 Z"/>

    <Style x:Key="MarcaDicon" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource Dicon.Text}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="120" Height="120">
                            <Path Data="M47.82,54.33 A22,22 0 0 1 65.67,72.18" Stroke="{TemplateBinding Foreground}" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M50.25,40.55 A36,36 0 0 1 79.45,69.75" Stroke="{TemplateBinding Foreground}" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M52.68,26.76 A50,50 0 0 1 93.24,67.32" Stroke="{TemplateBinding Foreground}" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Width="10.8" Height="10.8" Canvas.Left="38.6" Canvas.Top="70.6" Fill="{TemplateBinding Foreground}"/>
                            <Path Data="{StaticResource Dicon.EstrelaUnit}" Fill="{DynamicResource Dicon.Viavel}">
                                <Path.RenderTransform><TransformGroup><ScaleTransform ScaleX="5.6" ScaleY="5.6"/><TranslateTransform X="59.56" Y="60.44"/></TransformGroup></Path.RenderTransform>
                            </Path>
                            <Path Data="{StaticResource Dicon.EstrelaUnit}" Fill="{DynamicResource Dicon.Ressalva}">
                                <Path.RenderTransform><TransformGroup><ScaleTransform ScaleX="5.6" ScaleY="5.6"/><TranslateTransform X="69.46" Y="50.54"/></TransformGroup></Path.RenderTransform>
                            </Path>
                            <Path Data="{StaticResource Dicon.EstrelaUnit}" Fill="{DynamicResource Dicon.Inviavel}">
                                <Path.RenderTransform><TransformGroup><ScaleTransform ScaleX="5.6" ScaleY="5.6"/><TranslateTransform X="79.36" Y="40.64"/></TransformGroup></Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
