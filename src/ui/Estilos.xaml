<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta do log (fundo preto). Mantida em sincronia com $Global:LogCores
         em src/core/Log.ps1. Merge feito por Janela-Principal.ps1. -->
    <SolidColorBrush x:Key="LogInfo"     Color="SkyBlue"/>
    <SolidColorBrush x:Key="LogOk"       Color="LightGreen"/>
    <SolidColorBrush x:Key="LogAviso"    Color="Yellow"/>
    <SolidColorBrush x:Key="LogErro"     Color="OrangeRed"/>
    <SolidColorBrush x:Key="LogDestaque" Color="DeepPink"/>
    <SolidColorBrush x:Key="LogNeutro"   Color="Cyan"/>

    <!-- Cores de classificacao final -->
    <SolidColorBrush x:Key="ClasseViavel"   Color="LightGreen"/>
    <SolidColorBrush x:Key="ClasseRessalva" Color="Yellow"/>
    <SolidColorBrush x:Key="ClasseInviavel" Color="OrangeRed"/>
</ResourceDictionary>
