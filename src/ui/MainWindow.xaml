                    <Expander x:Name="expOrcamentoVpn" Header="Or&#231;amento da VPN (semeia o COM VPN de LAN e Celular)" Margin="0,10,0,0" IsExpanded="False">
                        <StackPanel Margin="6,8,0,0">
                            <TextBlock Text="Custo estimado do t&#250;nel: somado ao SEM VPN em lat&#234;ncia/jitter/perda e aplicado como desconto percentual em download/upload. &quot;Recalcular&quot; reescreve as colunas COM VPN de LAN e Celular (n&#227;o salva sozinho)."
                                       FontSize="11" Foreground="{DynamicResource Dicon.Text3}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                    <TextBlock Text="Lat&#234;ncia +ms" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="txtOrcLat" Width="58" MinHeight="30" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                    <TextBlock Text="Jitter +ms" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="txtOrcJit" Width="58" MinHeight="30" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                    <TextBlock Text="Perda +%" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="txtOrcPerda" Width="58" MinHeight="30" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                    <TextBlock Text="Download %" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="txtOrcDownPct" Width="58" MinHeight="30" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                    <TextBlock Text="Upload %" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="txtOrcUpPct" Width="58" MinHeight="30" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                            <Button x:Name="btnAplicarOrcamento" Content="Recalcular COM VPN (LAN e Celular)"
                                    Margin="0,8,0,0" HorizontalAlignment="Left" Style="{DynamicResource BotaoSecundario}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PIN do administrador"
                               Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <PasswordBox x:Name="txtPinAdmin" Grid.Column="1" Width="150" MinHeight="32"/>
                    <Button x:Name="btnSalvarLimiares" Grid.Column="2" Content="Salvar limiares"
                            Margin="12,0,0,0" Style="{DynamicResource BotaoSucesso}"/>
                    <Button x:Name="btnRecarregarLimiares" Grid.Column="3" Content="Recarregar"
                            Margin="8,0,0,0" Style="{DynamicResource BotaoSecundario}"/>
                    <TextBlock x:Name="lblAdminMsg" Grid.Column="4" VerticalAlignment="Center"
                               Margin="14,0,0,0" TextWrapping="Wrap" FontSize="12"/>
                </Grid>

                <StackPanel Grid.Row="4" VerticalAlignment="Top">
                    <Border Style="{DynamicResource Cartao}" Padding="16,14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Ambiente de teste (an&#225;lise de banda pela VPN)" Style="{DynamicResource SecaoTela}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Endere&#231;o do servidor de an&#225;lise de banda no CPD, alcan&#231;&#225;vel pela VPN. Salvo neste computador (config\ambiente.json)."
                                       FontSize="11" Foreground="{DynamicResource Dicon.Text3}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Servidor (IP/host)"
                                           Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtIperfServidorCfg" Grid.Column="1" MinHeight="32"
                                         FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Porta" Style="{DynamicResource Rotulo}"
                                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <TextBox x:Name="txtIperfPortaCfg" Grid.Column="3" Width="72" MinHeight="32"
                                         FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Dura&#231;&#227;o (s)" Style="{DynamicResource Rotulo}"
                                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <TextBox x:Name="txtIperfDuracaoCfg" Grid.Column="5" Width="60" MinHeight="32"
                                         FontFamily="Consolas" VerticalContentAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Sem&#225;foro do assistente de diagn&#243;stico" Style="{DynamicResource Rotulo}"
                                       Margin="0,14,0,4"/>
                            <TextBlock Text="Quais dos 3 itens aparecem no sem&#225;foro do overlay de checagem (so' informa se rodou, nao a qualidade do resultado)."
                                       FontSize="11" Foreground="{DynamicResource Dicon.Text3}" TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="chkOverlayRedeLocal" Content="Rede local (sem VPN)" IsChecked="True" Margin="0,0,20,0"/>
                                <CheckBox x:Name="chkOverlayVpn" Content="Diagn&#243;stico com a VPN" IsChecked="True" Margin="0,0,20,0"/>
                                <CheckBox x:Name="chkOverlayTotalizacao" Content="Sistema de totaliza&#231;&#227;o" IsChecked="True"/>
                            </StackPanel>

                            <TextBlock Text="Chave da API do Google Maps (Static)" Style="{DynamicResource Rotulo}"
                                       Margin="0,14,0,4"/>
                            <TextBlock Text="Restrita s&#243; &#224; Maps Static API. Usada no anexo do formul&#225;rio GEL para gerar a imagem do mapa no relat&#243;rio. Vazio = s&#243; o link, sem imagem."
                                       FontSize="11" Foreground="{DynamicResource Dicon.Text3}" TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="txtMapsKeyCfg" MinHeight="32" FontFamily="Consolas"
                                     VerticalContentAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnSalvarAmbiente" Content="Salvar ambiente"
                                        Style="{DynamicResource BotaoSucesso}"/>
                                <TextBlock x:Name="lblAmbienteMsg" Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="cardContaGoogle" Style="{DynamicResource Cartao}" Padding="16,14" Margin="0,16,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Conta Google" Style="{DynamicResource SecaoTela}" Margin="0,0,0,4"/>
                            <TextBlock Text="Usada para autenticar as chamadas ao servi&#231;o de dados (listas, limiares, envio de resultados) quando ele exige conta do dom&#237;nio. A conex&#227;o &#233; feita uma vez por computador; depois &#233; autom&#225;tica."
                                       FontSize="11" Foreground="{DynamicResource Dicon.Text3}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Conta:" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblContaGoogle" Text="n&#227;o conectada" VerticalAlignment="Center"
                                           FontFamily="Consolas" Foreground="{DynamicResource Dicon.Text}"/>
                                <mah:ProgressRing x:Name="ringContaGoogle" Width="16" Height="16" Margin="12,0,0,0"
                                                  IsActive="False" Visibility="Collapsed"
                                                  Foreground="{DynamicResource Dicon.Accent}"/>
                            </StackPanel>
                            <Border x:Name="panelDeviceCode" Style="{DynamicResource Faixa}" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Dicon.Text}">
                                        <Run Text="Sem navegador local. Acesse "/><Run x:Name="runDeviceUrl" Text="google.com/device" FontWeight="Bold"/><Run Text=" e digite o c&#243;digo:"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBox x:Name="txtDeviceCode" IsReadOnly="True" FontFamily="Consolas" FontSize="16"
                                                 FontWeight="Bold" MinWidth="140" VerticalContentAlignment="Center"/>
                                        <Button x:Name="btnCopiarDeviceCode" Content="Copiar" Margin="8,0,0,0"
                                                Style="{DynamicResource BotaoSecundario}"/>
                                        <Button x:Name="btnAbrirDeviceUrl" Content="Abrir no navegador" Margin="8,0,0,0"
                                                Style="{DynamicResource BotaoSecundario}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnConectarGoogle" Content="Conectar conta Google"
                                        Style="{DynamicResource BotaoSucesso}"/>
                                <Button x:Name="btnDesconectarGoogle" Content="Desconectar" Margin="8,0,0,0"
                                        Style="{DynamicResource BotaoFantasma}"/>
                                <TextBlock x:Name="lblContaGoogleMsg" Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnAdminVoltar" Content="Voltar ao in&#237;cio"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            Style="{DynamicResource BotaoFantasma}"/>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- ================= OVERLAY: CHECAGEM DO MEIO (modal) ================= -->
        <Grid x:Name="overlayCheck" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Background="#E60F1319" Visibility="Collapsed">
            <Border Style="{DynamicResource Cartao}" Width="1160" MaxHeight="740"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22">
                <DockPanel LastChildFill="True">

                    <!-- cabecalho + stepper + acao -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold" FontSize="21"
                                   Foreground="{DynamicResource Dicon.Text}"><Run Text="Checagem do meio &#8212; "/><Run
                                   x:Name="txtChkMeioTitulo" Text="LAN"/></TextBlock>
                        <TextBlock Text="Fase 1 (rede local, sem VPN) &#8594; Fase 2 (com a VPN do TRE) &#8594; Sistema de totaliza&#231;&#227;o"
                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}" Margin="0,2,0,12"/>

                        <StackPanel Margin="0,0,0,12">
                            <StackPanel x:Name="rowChkS1" Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="dotChkS1" Width="10" Height="10" VerticalAlignment="Center"
                                         Margin="0,0,8,0" Fill="{DynamicResource Dicon.Text3}"/>
                                <TextBlock x:Name="txtChkS1" FontSize="12" Foreground="{DynamicResource Dicon.Text2}"
                                           Text="1. Rede local (sem VPN) - pendente"/>
                            </StackPanel>
                            <StackPanel x:Name="rowChkS2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse x:Name="dotChkS2" Width="10" Height="10" VerticalAlignment="Center"
                                         Margin="0,0,8,0" Fill="{DynamicResource Dicon.Text3}"/>
                                <TextBlock x:Name="txtChkS2" FontSize="12" Foreground="{DynamicResource Dicon.Text2}"
                                           Text="2. Diagnostico com a VPN - pendente"/>
                            </StackPanel>
                            <StackPanel x:Name="rowChkS3" Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse x:Name="dotChkS3" Width="10" Height="10" VerticalAlignment="Center"
                                         Margin="0,0,8,0" Fill="{DynamicResource Dicon.Text3}"/>
                                <TextBlock x:Name="txtChkS3" FontSize="12" Foreground="{DynamicResource Dicon.Text3}"
                                           Text="3. Sistema de totalizacao - em implementacao"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="rowChkAcao" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="btnChkIniciar" Content="Iniciar checagem da rede local"
                                    Style="{DynamicResource BotaoPrimario}" Padding="22,9"/>
                            <mah:ProgressRing x:Name="ringChk" Width="18" Height="18" Margin="12,0,0,0"
                                              IsActive="False" Visibility="Collapsed"
                                              Foreground="{DynamicResource Dicon.Accent}"/>
                        </StackPanel>

                        <!-- gate da VPN (Fase 2 sem VPN ativa) -->
                        <Border x:Name="panelChkVpnGate" Style="{DynamicResource Faixa}" Visibility="Collapsed"
                                Margin="0,8,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="dotVpn" Width="10" Height="10" Margin="0,5,8,0"
                                             VerticalAlignment="Top" Fill="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtDiagVpn" TextWrapping="Wrap" VerticalAlignment="Center"
                                               FontSize="12" LineHeight="17" Foreground="{DynamicResource Dicon.Text2}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="btnAbrirFortiClient" Content="Abrir o FortiClient"
                                            Style="{DynamicResource BotaoSecundario}"/>
                                    <Button x:Name="btnReverificarVpn" Content="Verificar novamente"
                                            Style="{DynamicResource BotaoFantasma}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="chkVpnImpossivel" Margin="0,14,0,0"
                                          Content="N&#227;o foi poss&#237;vel conectar a VPN da JE neste local"/>
                                <TextBox x:Name="txtVpnMotivo" Margin="0,8,0,0" MinHeight="72"
                                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         Padding="8,6" Visibility="Collapsed"/>
                                <TextBlock x:Name="txtVpnMotivoDica" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"
                                           Text="Descreva o que impediu a conex&#227;o (FortiClient, credencial, link...). Vai no relat&#243;rio; o meio fica registrado como INVI&#193;VEL."/>
                                <Button x:Name="btnChkVpnImpossivel" Content="Registrar este meio sem a VPN"
                                        Style="{DynamicResource BotaoSecundario}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- rodape -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="btnChkFechar" Content="Cancelar"
                                Style="{DynamicResource BotaoSecundario}" Padding="24,8"/>
                    </StackPanel>

                    <!-- corpo: 3 colunas + log -->
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUNA 1: servidor / IP -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ORIGEM DA CONEX&#195;O" FontFamily="Consolas" FontSize="9"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,8"/>
                                <StackPanel x:Name="grpF1Conn">
                                    <StackPanel x:Name="panelSpeedConn">
                                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text3}" Margin="0,3,0,0"><Run Text="Provedor: "/><Run
                                                   x:Name="runConnProvedor" FontWeight="SemiBold" Foreground="{DynamicResource Dicon.Text}"/></TextBlock>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text3}" Margin="0,6,0,0"><Run Text="Servidor: "/><Run
                                                   x:Name="runConnServidor" FontWeight="SemiBold" Foreground="{DynamicResource Dicon.Text}"/></TextBlock>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text3}" Margin="0,6,0,0"><Run Text="IP: "/><Run
                                                   x:Name="runConnIp" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource Dicon.Text}"/></TextBlock>
                                    </StackPanel>
                                    <TextBlock x:Name="txtSpeedErro" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{DynamicResource Dicon.Inviavel}" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel x:Name="grpF2Conn" Visibility="Collapsed">
                                    <TextBlock x:Name="txtIperfInfo" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtIperfServidor" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Dicon.Text2}"/>
                                    <TextBlock x:Name="txtIperfErro" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{DynamicResource Dicon.Inviavel}" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- COLUNA 2: velocimetro -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MEDI&#199;&#195;O" FontFamily="Consolas" FontSize="9"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Canvas x:Name="canvasVelo" Width="280" Height="235" HorizontalAlignment="Center">
                                        <Path StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{DynamicResource Dicon.Hair}">
                                            <Path.Data><PathGeometry><PathFigure StartPoint="62.22,217.78">
                                                <ArcSegment Point="217.78,217.78" Size="110,110" SweepDirection="Clockwise" IsLargeArc="True"/>
                                            </PathFigure></PathGeometry></Path.Data>
                                        </Path>
                                        <Path StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#6E9BFF" Offset="0"/><GradientStop Color="#4FC177" Offset="1"/>
                                            </LinearGradientBrush></Path.Stroke>
                                            <Path.Data><PathGeometry><PathFigure StartPoint="62.22,217.78">
                                                <ArcSegment x:Name="segVelo" Point="62.22,217.78" Size="110,110" SweepDirection="Clockwise" IsLargeArc="False"/>
                                            </PathFigure></PathGeometry></Path.Data>
                                        </Path>
                                        <Path Fill="{DynamicResource Dicon.Text}" Data="M -3.5,0 L 3.5,0 L 0,-100 Z">
                                            <Path.RenderTransform><TransformGroup>
                                                <RotateTransform x:Name="rotAgulha" Angle="-135"/>
                                                <TranslateTransform X="140" Y="140"/>
                                            </TransformGroup></Path.RenderTransform>
                                        </Path>
                                        <Ellipse Width="16" Height="16" Fill="{DynamicResource Dicon.Text}" Canvas.Left="132" Canvas.Top="132"/>
                                        <StackPanel Canvas.Left="45" Canvas.Top="96" Width="190">
                                            <TextBlock x:Name="txtVeloNum" Text="0" FontSize="32" FontWeight="Bold"
                                                       TextAlignment="Center" Foreground="{DynamicResource Dicon.Text}"/>
                                            <TextBlock x:Name="txtVeloUnid" Text="Mbps" FontSize="11" TextAlignment="Center"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                            <TextBlock x:Name="txtVeloFase" Text="" FontFamily="Consolas" FontSize="9"
                                                       TextAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource Dicon.Text3}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="tickVelo0" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVelo1" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVelo2" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVelo3" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVelo4" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVelo5" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVelo6" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    </Canvas>
                                    <Canvas x:Name="canvasVeloVpn" Width="280" Height="235" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <Path StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{DynamicResource Dicon.Hair}">
                                            <Path.Data><PathGeometry><PathFigure StartPoint="62.22,217.78">
                                                <ArcSegment Point="217.78,217.78" Size="110,110" SweepDirection="Clockwise" IsLargeArc="True"/>
                                            </PathFigure></PathGeometry></Path.Data>
                                        </Path>
                                        <Path StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#6E9BFF" Offset="0"/><GradientStop Color="#4FC177" Offset="1"/>
                                            </LinearGradientBrush></Path.Stroke>
                                            <Path.Data><PathGeometry><PathFigure StartPoint="62.22,217.78">
                                                <ArcSegment x:Name="segVeloVpn" Point="62.22,217.78" Size="110,110" SweepDirection="Clockwise" IsLargeArc="False"/>
                                            </PathFigure></PathGeometry></Path.Data>
                                        </Path>
                                        <Path Fill="{DynamicResource Dicon.Text}" Data="M -3.5,0 L 3.5,0 L 0,-100 Z">
                                            <Path.RenderTransform><TransformGroup>
                                                <RotateTransform x:Name="rotAgulhaVpn" Angle="-135"/>
                                                <TranslateTransform X="140" Y="140"/>
                                            </TransformGroup></Path.RenderTransform>
                                        </Path>
                                        <Ellipse Width="16" Height="16" Fill="{DynamicResource Dicon.Text}" Canvas.Left="132" Canvas.Top="132"/>
                                        <StackPanel Canvas.Left="45" Canvas.Top="96" Width="190">
                                            <TextBlock x:Name="txtVeloNumVpn" Text="0" FontSize="32" FontWeight="Bold"
                                                       TextAlignment="Center" Foreground="{DynamicResource Dicon.Text}"/>
                                            <TextBlock x:Name="txtVeloUnidVpn" Text="Mbps" FontSize="11" TextAlignment="Center"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                            <TextBlock x:Name="txtVeloFaseVpn" Text="" FontFamily="Consolas" FontSize="9"
                                                       TextAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource Dicon.Text3}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="tickVeloVpn0" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVeloVpn1" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVeloVpn2" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVeloVpn3" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVeloVpn4" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVeloVpn5" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="tickVeloVpn6" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    </Canvas>
                                </Grid>
                                <ProgressBar x:Name="prgSpeed" Height="4" Minimum="0" Maximum="1" Value="0" Margin="0,4,0,0"
                                             BorderThickness="0" Background="{DynamicResource Dicon.Hair}"
                                             Foreground="{DynamicResource Dicon.Accent}"/>
                                <ProgressBar x:Name="prgSpeedVpn" Height="4" Minimum="0" Maximum="1" Value="0" Margin="0,4,0,0"
                                             BorderThickness="0" Background="{DynamicResource Dicon.Hair}" Visibility="Collapsed"
                                             Foreground="{DynamicResource Dicon.Accent}"/>
                                <ProgressBar x:Name="prgProgresso" Height="1" Visibility="Collapsed"/>
                                <mah:ProgressRing x:Name="ringDiag" Width="14" Height="14" IsActive="False"
                                                  Visibility="Collapsed" HorizontalAlignment="Center"
                                                  Foreground="{DynamicResource Dicon.Accent}"/>
                            </StackPanel>

                            <!-- COLUNA 3: resultado -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="RESULTADO" FontFamily="Consolas" FontSize="9"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtChkResultadoVazio" Text="Rode a checagem para ver o resultado aqui."
                                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text3}"/>
                                <Grid x:Name="painelSpeedResultado" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{DynamicResource Faixa}" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource Dicon.Text}"><Run Text="DOWN " FontFamily="Consolas" FontSize="9"
                                                       Foreground="{DynamicResource Dicon.Text3}"/><Run x:Name="runResDown" Text="--" FontSize="20" FontWeight="Bold"/><Run
                                                       Text=" Mbps" FontSize="10" Foreground="{DynamicResource Dicon.Text2}"/></TextBlock>
                                        </Border>
                                        <Border Style="{DynamicResource Faixa}" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource Dicon.Text}"><Run Text="UP " FontFamily="Consolas" FontSize="9"
                                                       Foreground="{DynamicResource Dicon.Text3}"/><Run x:Name="runResUp" Text="--" FontSize="20" FontWeight="Bold"/><Run
                                                       Text=" Mbps" FontSize="10" Foreground="{DynamicResource Dicon.Text2}"/></TextBlock>
                                        </Border>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Dicon.Text2}" Margin="0,2,0,0"><Run Text="ping "/><Run
                                                   x:Name="runResPing" Text="--" FontWeight="Bold" Foreground="{DynamicResource Dicon.Text}"/><Run Text=" ms   jitter "/><Run
                                                   x:Name="runResJitter" Text="--" FontWeight="Bold" Foreground="{DynamicResource Dicon.Text}"/><Run Text=" ms   perda "/><Run
                                                   x:Name="runResPerda" Text="--" FontWeight="Bold" Foreground="{DynamicResource Dicon.Text}"/><Run Text=" %"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="painelIperfResultado" Visibility="Collapsed" Margin="0,4,0,0">
                                    <StackPanel>
                                        <Border Style="{DynamicResource Faixa}" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource Dicon.Text}"><Run Text="DOWN VPN " FontFamily="Consolas" FontSize="9"
                                                       Foreground="{DynamicResource Dicon.Text3}"/><Run x:Name="runIperfDown" Text="--" FontSize="20" FontWeight="Bold"/><Run
                                                       Text=" Mbps" FontSize="10" Foreground="{DynamicResource Dicon.Text2}"/></TextBlock>
                                        </Border>
                                        <Border Style="{DynamicResource Faixa}" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource Dicon.Text}"><Run Text="UP VPN " FontFamily="Consolas" FontSize="9"
                                                       Foreground="{DynamicResource Dicon.Text3}"/><Run x:Name="runIperfUp" Text="--" FontSize="20" FontWeight="Bold"/><Run
                                                       Text=" Mbps" FontSize="10" Foreground="{DynamicResource Dicon.Text2}"/></TextBlock>
                                        </Border>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Dicon.Text2}" Margin="0,2,0,0"><Run Text="ping "/><Run
                                                   x:Name="runIperfPing" Text="--" FontWeight="Bold" Foreground="{DynamicResource Dicon.Text}"/><Run Text=" ms   jitter "/><Run
                                                   x:Name="runIperfJitter" Text="--" FontWeight="Bold" Foreground="{DynamicResource Dicon.Text}"/><Run Text=" ms"/></TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Dicon.Text2}" Margin="0,2,0,0"><Run Text="perda "/><Run
                                                   x:Name="runIperfPerda" Text="--" FontWeight="Bold" Foreground="{DynamicResource Dicon.Text}"/><Run Text=" %   retr. "/><Run
                                                   x:Name="runIperfRetrans" Text="--" FontWeight="Bold" Foreground="{DynamicResource Dicon.Text}"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- LOG: uma coluna so -->
                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <TextBlock Text="Detalhes da execu&#231;&#227;o" Style="{DynamicResource SecaoTela}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource Dicon.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                                    CornerRadius="4" Height="150">
                                <ListBox x:Name="lstLog" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Dicon.Text2}" FontFamily="Consolas" FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Hora}" Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Texto}" Foreground="{Binding Cor}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</mah:MetroWindow>
