                                                        <Run x:Name="runResUp" Text="--" FontSize="22" FontWeight="Bold"/>
                                                        <Run Text=" Mbps" FontSize="11" Foreground="{DynamicResource Dicon.Text2}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,8,0,0">
