                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 4: rodar o diagnostico (COM a VPN do TRE) -->
                    <ScrollViewer x:Name="stepDiag" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                      <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="txtDiagLocal" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Dicon.Text2}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse x:Name="dotVpn" Width="10" Height="10" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource Dicon.Text3}"/>
                                <TextBlock x:Name="txtDiagVpn" TextWrapping="Wrap" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnRodar" Content="Rodar diagn&#243;stico"
                                        Style="{DynamicResource BotaoPrimario}"/>
                                <Button x:Name="btnAbrirFortiClient" Content="Abrir o FortiClient"
                                        Style="{DynamicResource BotaoSecundario}" Margin="10,0,0,0"
                                        Visibility="Collapsed"/>
                                <Button x:Name="btnReverificarVpn" Content="Verificar novamente"
                                        Style="{DynamicResource BotaoFantasma}" Margin="8,0,0,0"
                                        Visibility="Collapsed"/>
                            </StackPanel>

                            <CheckBox x:Name="chkVpnImpossivel" Margin="0,16,0,0"
                                      Content="N&#227;o foi poss&#237;vel conectar a VPN da JE neste local"/>
                            <TextBox x:Name="txtVpnMotivo" Margin="0,8,0,0" MinHeight="110" MaxWidth="860"
                                     HorizontalAlignment="Stretch" TextWrapping="Wrap" AcceptsReturn="True"
                                     AcceptsTab="False" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" Padding="8,6" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtVpnMotivoDica" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"
                                       Text="Descreva o que impediu a conex&#227;o (FortiClient, credencial, link...). Vai no relat&#243;rio; o local fica registrado como INVI&#193;VEL."/>

                            <Border Style="{DynamicResource Faixa}" Margin="0,18,0,0" Visibility="Collapsed"
                                    x:Name="cardOutroMeio">
                                <StackPanel>
                                    <TextBlock x:Name="txtMedicoesFeitas" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource Dicon.Text2}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="btnTestarOutroMeio" Content="Testar outro meio neste local"
                                                Style="{DynamicResource BotaoSecundario}"/>
                                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource Dicon.Text3}"
                                                   Text="ou clique em &quot;Pr&#243;ximo&quot; para ver o resultado."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border x:Name="cardIperfVpn" Grid.Row="1" Style="{DynamicResource Cartao}"
                                Padding="16,14" Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Banda pela VPN (iperf3)" Style="{DynamicResource SecaoTela}"/>
                                    <mah:ProgressRing x:Name="ringDiag" Width="16" Height="16" Margin="10,0,0,0"
                                                      IsActive="False" Visibility="Collapsed"
                                                      Foreground="{DynamicResource Dicon.Accent}"/>
                                </StackPanel>
                                <TextBlock x:Name="txtIperfInfo" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtIperfErro" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Inviavel}" Visibility="Collapsed" Margin="0,2,0,0"/>

                                <Canvas x:Name="canvasVeloVpn" Width="280" Height="235" HorizontalAlignment="Center"
                                        Margin="0,4,0,0">
                                    <Path StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{DynamicResource Dicon.Hair}">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="62.22,217.78">
                                                    <ArcSegment Point="217.78,217.78" Size="110,110"
                                                                SweepDirection="Clockwise" IsLargeArc="True"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Path StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#6E9BFF" Offset="0"/>
                                                <GradientStop Color="#4FC177" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Stroke>
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="62.22,217.78">
                                                    <ArcSegment x:Name="segVeloVpn" Point="62.22,217.78" Size="110,110"
                                                                SweepDirection="Clockwise" IsLargeArc="False"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Path Fill="{DynamicResource Dicon.Text}" Data="M -3.5,0 L 3.5,0 L 0,-100 Z">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform x:Name="rotAgulhaVpn" Angle="-135"/>
                                                <TranslateTransform X="140" Y="140"/>
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                    <Ellipse Width="16" Height="16" Fill="{DynamicResource Dicon.Text}"
                                             Canvas.Left="132" Canvas.Top="132"/>
                                    <StackPanel Canvas.Left="45" Canvas.Top="96" Width="190">
                                        <TextBlock x:Name="txtVeloNumVpn" Text="0" FontSize="32" FontWeight="Bold"
                                                   TextAlignment="Center" Foreground="{DynamicResource Dicon.Text}"/>
                                        <TextBlock x:Name="txtVeloUnidVpn" Text="Mbps" FontSize="11" TextAlignment="Center"
                                                   Foreground="{DynamicResource Dicon.Text2}"/>
                                        <TextBlock x:Name="txtVeloFaseVpn" Text="" FontFamily="Consolas" FontSize="9"
                                                   TextAlignment="Center" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Dicon.Text3}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="tickVeloVpn0" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="tickVeloVpn1" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="tickVeloVpn2" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="tickVeloVpn3" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="tickVeloVpn4" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="tickVeloVpn5" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="tickVeloVpn6" FontFamily="Consolas" FontSize="8" Foreground="{DynamicResource Dicon.Text3}"/>
                                </Canvas>

                                <ProgressBar x:Name="prgSpeedVpn" Height="4" Minimum="0" Maximum="1" Value="0"
                                             Margin="0,4,0,0" BorderThickness="0"
                                             Background="{DynamicResource Dicon.Hair}"
                                             Foreground="{DynamicResource Dicon.Accent}"/>
                                <ProgressBar x:Name="prgProgresso" Height="1" Visibility="Collapsed"/>

                                <Grid x:Name="painelIperfResultado" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <UniformGrid Grid.Row="0" Rows="1" Columns="2">
                                        <Border Style="{DynamicResource Faixa}" Margin="0,0,5,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M8,2 L8,11 M4,8 L8,12 L12,8" Stretch="Uniform" Width="13" Height="13"
                                                          Stroke="{DynamicResource Dicon.Accent}" StrokeThickness="1.8"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="DOWNLOAD (VPN)" FontFamily="Consolas" FontSize="9"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Dicon.Text}">
                                                    <Run x:Name="runIperfDown" Text="--" FontSize="22" FontWeight="Bold"/>
                                                    <Run Text=" Mbps" FontSize="11" Foreground="{DynamicResource Dicon.Text2}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{DynamicResource Faixa}" Margin="5,0,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M8,14 L8,5 M4,9 L8,4 L12,9" Stretch="Uniform" Width="13" Height="13"
                                                          Stroke="{DynamicResource Dicon.Viavel}" StrokeThickness="1.8"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="UPLOAD (VPN)" FontFamily="Consolas" FontSize="9"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Dicon.Text}">
                                                    <Run x:Name="runIperfUp" Text="--" FontSize="22" FontWeight="Bold"/>
                                                    <Run Text=" Mbps" FontSize="11" Foreground="{DynamicResource Dicon.Text2}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,8 L5,8 L7,3 L9,13 L11,8 L15,8" Stretch="Uniform" Width="14" Height="14"
                                                  Stroke="{DynamicResource Dicon.Text2}" StrokeThickness="1.6" VerticalAlignment="Center"/>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{DynamicResource Dicon.Text2}">
                                                <Run Text="ping "/><Run x:Name="runIperfPing" Text="--" FontWeight="Bold"
                                                     Foreground="{DynamicResource Dicon.Text}"/><Run Text=" ms"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,8 Q4,3 7,8 T13,8" Stretch="Uniform" Width="14" Height="14"
                                                  Stroke="{DynamicResource Dicon.Text2}" StrokeThickness="1.6" VerticalAlignment="Center"/>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{DynamicResource Dicon.Text2}">
                                                <Run Text="jitter "/><Run x:Name="runIperfJitter" Text="--" FontWeight="Bold"
                                                     Foreground="{DynamicResource Dicon.Text}"/><Run Text=" ms"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M2,3 L13,13 M13,3 L2,13" Stretch="Uniform" Width="12" Height="12"
                                                  Stroke="{DynamicResource Dicon.Text2}" StrokeThickness="1.6" VerticalAlignment="Center"/>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{DynamicResource Dicon.Text2}">
                                                <Run Text="perda "/><Run x:Name="runIperfPerda" Text="--" FontWeight="Bold"
                                                     Foreground="{DynamicResource Dicon.Text}"/><Run Text=" %"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M2,7 A5,5 0 1 1 12,7 M12,7 L12,3 M12,7 L8,7" Stretch="Uniform" Width="13" Height="13"
                                                  Stroke="{DynamicResource Dicon.Text2}" StrokeThickness="1.4" VerticalAlignment="Center"/>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{DynamicResource Dicon.Text2}">
                                                <Run Text="retr. "/><Run x:Name="runIperfRetrans" Text="--" FontWeight="Bold"
                                                     Foreground="{DynamicResource Dicon.Text}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </UniformGrid>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Path Data="M2,4 L14,4 L14,7 L2,7 Z M2,9 L14,9 L14,12 L2,12 Z" Stretch="Uniform"
                                              Width="13" Height="13" Fill="{DynamicResource Dicon.Text3}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtIperfServidor" Margin="7,0,0,0" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Expander Grid.Row="2" Header="Detalhes da execu&#231;&#227;o" Margin="0,14,0,0"
                                  VerticalAlignment="Top" Foreground="{DynamicResource Dicon.Text2}"
                                  IsExpanded="False">
                            <Border Background="{DynamicResource Dicon.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,8,0,0" Height="200">
                                <ListBox x:Name="lstLog" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Dicon.Text2}" FontFamily="Consolas"
                                         FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Hora}"
                                                           Foreground="{DynamicResource Dicon.Text3}"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Texto}" Foreground="{Binding Cor}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Expander>
                      </Grid>
                    </ScrollViewer>

                    <!-- PASSO 5: resultado por metrica -->
                    <ScrollViewer x:Name="stepResultado" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SubtituloTela}" Margin="0,0,0,10"
                                       Text="Ajuste a classifica&#231;&#227;o de uma m&#233;trica se necess&#225;rio &#8212; nesse caso, informe o motivo."/>
                            <StackPanel x:Name="boxMedicaoPasso5" Orientation="Horizontal" Margin="0,0,0,10"
                                        Visibility="Collapsed">
                                <TextBlock Text="Medi&#231;&#227;o:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Dicon.Text3}" FontSize="12"/>
                                <ComboBox x:Name="cboMedicaoPasso5" MinWidth="340" MinHeight="30"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtMetricasDesativadas" Margin="0,0,0,8" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="11" Visibility="Collapsed"
                                       Foreground="{DynamicResource Dicon.Ressalva}"/>
                            <DataGrid x:Name="dgAvaliacao" Style="{DynamicResource GridMetricas}"
                                      MaxHeight="340" RowHeight="40"
                                      CanUserResizeRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="6" CanUserResize="False" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CorFinal}" CornerRadius="2" Margin="0,3"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}"
                                                        IsReadOnly="True" Width="130"/>
                                    <DataGridTextColumn Header="Valor medido" Binding="{Binding ValorTexto}"
                                                        IsReadOnly="True" Width="110" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="Faixa aceit&#225;vel" Binding="{Binding Regra}"
                                                        IsReadOnly="True" Width="250" FontFamily="Consolas"/>
                                    <DataGridTemplateColumn Header="Sugerida" Width="90" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ClasseAutomatica}"
                                                           Style="{DynamicResource ChipVeredito}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Classifica&#231;&#227;o" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Margin="2" VerticalContentAlignment="Center"
                                                          ItemsSource="{StaticResource classesMetrica}"
                                                          SelectedItem="{Binding ClasseFinal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Motivo do ajuste" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Margin="2" TextWrapping="Wrap" AcceptsReturn="True"
                                                         VerticalContentAlignment="Center"
                                                         Visibility="{Binding Ajustada, Converter={StaticResource boolVis}}"
                                                         Text="{Binding Justificativa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 6: decisao final -->
                    <ScrollViewer x:Name="stepDecisao" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{DynamicResource Cartao}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="barraDecisaoStripe" Grid.Column="0" Width="4"
                                            CornerRadius="2" Margin="0,0,14,0"
                                            Background="{DynamicResource Dicon.Text3}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="DECIS&#195;O FINAL" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="txtDecisaoPalavra" Text="&#8212;"
                                                   FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold"
                                                   FontSize="20" Foreground="{DynamicResource Dicon.Text}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="cboDecisaoFinal" Grid.Column="2" Width="200" MinHeight="32"
                                              VerticalContentAlignment="Center" VerticalAlignment="Center"
                                              ItemsSource="{StaticResource classesDecisao}"/>
                                    <TextBlock x:Name="lblDecisaoRecalc" Grid.Column="3"
                                               Foreground="{DynamicResource Dicon.Text3}"
                                               VerticalAlignment="Center" Margin="14,0" FontFamily="Consolas"
                                               FontSize="11"/>
                                    <TextBlock x:Name="lblJustDecisao" Grid.Column="4" Text="Motivo do ajuste:"
                                               Foreground="{DynamicResource Dicon.Text3}"
                                               VerticalAlignment="Center" Margin="6,0,6,0" FontSize="12"
                                               Visibility="Collapsed"/>
                                    <TextBox x:Name="txtJustDecisao" Grid.Column="5" MinHeight="32"
                                             VerticalContentAlignment="Center" VerticalAlignment="Center"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{DynamicResource SubtituloTela}" Margin="0,12,0,0"
                                       Text="A decis&#227;o final vem do pior caso entre as m&#233;tricas. Voc&#234; pode sobrescrev&#234;-la aqui &#8212; nesse caso, informe o motivo."/>

                            <!-- conexao recomendada para o local (multi-meio) -->
                            <Border Style="{DynamicResource Cartao}" Padding="16,14" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="CONEX&#195;O RECOMENDADA PARA ESTE LOCAL"
                                               FontFamily="Consolas" FontSize="9"
                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                    <ComboBox x:Name="cboConexaoRec" Width="380" MinHeight="32" Margin="0,6,0,0"
                                              HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="lblRecContexto" Margin="0,8,0,0" TextWrapping="Wrap"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource Dicon.Text2}"/>
                                    <TextBlock Text="Motivo da recomenda&#231;&#227;o (obrigat&#243;rio):" Margin="0,12,0,4"
                                               Foreground="{DynamicResource Dicon.Text3}" FontSize="12"/>
                                    <TextBox x:Name="txtMotivoRec" MinHeight="60" TextWrapping="Wrap"
                                             AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Medi&#231;&#245;es feitas neste local"
                                       Style="{DynamicResource SecaoTela}" Margin="0,16,0,6"/>
                            <DataGrid x:Name="dgMedicoes" Style="{DynamicResource GridMetricas}"
                                      MaxHeight="220" RowHeight="34" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserResizeRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Meio" Binding="{Binding Meio}" Width="230"/>
                                    <DataGridTextColumn Header="Rede Local" Binding="{Binding RedeLocal}"
                                                        Width="130" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="VPN" Binding="{Binding Vpn}" Width="90"/>
                                    <DataGridTextColumn Header="Download VPN" Binding="{Binding VpnDown}"
                                                        Width="120" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="Veredito" Binding="{Binding Veredito}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 7: conclusao / exportar -->
                    <ScrollViewer x:Name="stepFim" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <Border Style="{DynamicResource Cartao}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="Diagn&#243;stico conclu&#237;do" Style="{DynamicResource SecaoTela}"/>
                                <TextBlock x:Name="txtFimLocal" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="DECIS&#195;O FINAL" FontFamily="Consolas" FontSize="9"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtFimVeredito" Text="&#8212;" Margin="10,0,0,0"
                                               FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold"
                                               FontSize="20" Foreground="{DynamicResource Dicon.Text}"/>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Dicon.Text3}">O resultado fica salvo
                                    neste computador. <Run FontWeight="Bold">Transmitir</Run> envia agora ao
                                    painel (com internet); sen&#227;o ele vai junto no pr&#243;ximo
                                    "Atualizar dados" / "Reenviar".</TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="btnSalvarResultado" Content="Salvar resultado"
                                            Style="{DynamicResource BotaoSucesso}" IsEnabled="False"/>
                                    <Button x:Name="btnTransmitirResultado" Content="Transmitir resultado"
                                            Style="{DynamicResource BotaoPrimario}" Margin="10,0,0,0"
                                            IsEnabled="False"/>
                                    <Button x:Name="btnExportarPdf" Content="Exportar relat&#243;rio (PDF)"
                                            Style="{DynamicResource BotaoSecundario}" Margin="10,0,0,0"
                                            IsEnabled="False"/>
                                    <mah:ProgressRing x:Name="ringFim" Width="18" Height="18" Margin="12,0,0,0"
                                                      IsActive="False" Visibility="Collapsed"
                                                      Foreground="{DynamicResource Dicon.Accent}"/>
                                </StackPanel>
                                <TextBlock x:Name="txtFimStatus" Margin="0,12,0,0" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>

                                <Border Style="{DynamicResource Faixa}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="A&#199;&#213;ES" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimSalvar" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Salvar resultado" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimTransmitir" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Transmitir resultado" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimExportar" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Exportar relat&#243;rio (PDF)" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="btnFinalizarDiag" Margin="0,20,0,0" HorizontalAlignment="Left"
                                        Style="{DynamicResource BotaoPrimario}" IsEnabled="False" Padding="18,9">
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Stroke="{DynamicResource Dicon.Deep}" StrokeThickness="1.6"
                                                  Data="M3,1 L3,17"/>
                                            <Path Stroke="{DynamicResource Dicon.Deep}" StrokeThickness="1.4"
                                                  Fill="{DynamicResource Dicon.Deep}"
                                                  Data="M4,2 L16,2 L16,10 L4,10 Z M4,2 L10,2 L10,6 L4,6 Z M10,6 L16,6 L16,10 L10,10 Z"/>
                                        </Canvas>
                                        <TextBlock Text="Finalizar" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="txtFimFinalizarDica" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                </Grid>

                <!-- rodape: navegacao do assistente -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnDiagVoltar" Grid.Column="0" Content="Sair do assistente"
                            Style="{DynamicResource BotaoFantasma}"/>
                    <Button x:Name="btnWizVoltar" Grid.Column="2" Content="Voltar"
                            Style="{DynamicResource BotaoSecundario}" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button x:Name="btnWizProximo" Grid.Column="3" Content="Pr&#243;ximo"
                            Style="{DynamicResource BotaoPrimario}"/>
                </Grid>
            </Grid>

            <!-- ===== ADMIN (LIMIARES) ===== -->
            <Grid x:Name="viewAdmin" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Administra&#231;&#227;o &#8212; limiares de decis&#227;o"
                           Style="{DynamicResource TituloTela}"/>
                <TextBlock Grid.Row="1"
                           Text="Valores que definem vi&#225;vel / ressalva / invi&#225;vel por m&#233;trica. Desmarque &quot;Na bateria&quot; para tirar uma m&#233;trica do teste. Salvos na planilha de configura&#231;&#227;o e usados por todos os computadores."
                           Style="{DynamicResource SubtituloTela}" Margin="0,6,0,14"/>

                <Border Grid.Row="2" Style="{DynamicResource Cartao}" Padding="2">
                    <DataGrid x:Name="dgLimiares" Style="{DynamicResource GridMetricas}"
                              BorderThickness="0" RowHeight="42" MaxHeight="300"
                              CanUserResizeRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Na bateria" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="8,0,0,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Ativo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}"
                                                IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unidade}"
                                                IsReadOnly="True" Width="72" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Dire&#231;&#227;o" Binding="{Binding DirecaoTexto}"
                                                IsReadOnly="True" Width="130"/>
                            <DataGridTemplateColumn Header="Ideal" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                 Text="{Binding LimiarViavel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Limite" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                 Text="{Binding LimiarRessalva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PIN do administrador"
                               Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <PasswordBox x:Name="txtPinAdmin" Grid.Column="1" Width="150" MinHeight="32"/>
                    <Button x:Name="btnSalvarLimiares" Grid.Column="2" Content="Salvar limiares"
                            Margin="12,0,0,0" Style="{DynamicResource BotaoSucesso}"/>
                    <Button x:Name="btnRecarregarLimiares" Grid.Column="3" Content="Recarregar"
                            Margin="8,0,0,0" Style="{DynamicResource BotaoSecundario}"/>
                    <TextBlock x:Name="lblAdminMsg" Grid.Column="4" VerticalAlignment="Center"
                               Margin="14,0,0,0" TextWrapping="Wrap" FontSize="12"/>
                </Grid>

                <StackPanel Grid.Row="4" VerticalAlignment="Top">
                    <Border Style="{DynamicResource Cartao}" Padding="16,14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Ambiente de teste (iperf3)" Style="{DynamicResource SecaoTela}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Endere&#231;o do servidor iperf3 no CPD, alcan&#231;&#225;vel pela VPN. Salvo neste computador (config\ambiente.json)."
                                       FontSize="11" Foreground="{DynamicResource Dicon.Text3}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Servidor (IP/host)"
                                           Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtIperfServidorCfg" Grid.Column="1" MinHeight="32"
                                         FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Porta" Style="{DynamicResource Rotulo}"
                                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <TextBox x:Name="txtIperfPortaCfg" Grid.Column="3" Width="72" MinHeight="32"
                                         FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Dura&#231;&#227;o (s)" Style="{DynamicResource Rotulo}"
                                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <TextBox x:Name="txtIperfDuracaoCfg" Grid.Column="5" Width="60" MinHeight="32"
                                         FontFamily="Consolas" VerticalContentAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnSalvarAmbiente" Content="Salvar ambiente"
                                        Style="{DynamicResource BotaoSucesso}"/>
                                <TextBlock x:Name="lblAmbienteMsg" Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnAdminVoltar" Content="Voltar ao in&#237;cio"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            Style="{DynamicResource BotaoFantasma}"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</mah:MetroWindow>
