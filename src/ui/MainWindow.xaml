<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="DICON &#8212; Diagn&#243;stico de Conectividade"
        Height="760" Width="1120"
        MinHeight="620" MinWidth="940"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        TitleCharacterCasing="Normal"
        SaveWindowPosition="False"
        Background="{DynamicResource Dicon.Bg}"
        Foreground="{DynamicResource Dicon.Text}"
        FontFamily="{DynamicResource Dicon.Body}"
        FontSize="14"
        WindowTitleBrush="{DynamicResource Dicon.Deep}"
        NonActiveWindowTitleBrush="{DynamicResource Dicon.Deep}">

    <Window.Resources>
        <x:Array x:Key="classesMetrica" Type="sys:String">
            <sys:String>viavel</sys:String>
            <sys:String>ressalva</sys:String>
            <sys:String>inviavel</sys:String>
        </x:Array>
        <x:Array x:Key="classesDecisao" Type="sys:String">
            <sys:String>viavel</sys:String>
            <sys:String>viavel_com_ressalva</sys:String>
            <sys:String>inviavel</sys:String>
        </x:Array>
        <BooleanToVisibilityConverter x:Key="boolVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== RAIL DE NAVEGACAO (oculto no login) ========== -->
        <Border x:Name="railNav" Grid.Column="0" Width="214"
                Background="{DynamicResource Dicon.SurfaceAlt}"
                BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,8">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{DynamicResource MarcaDicon}" Width="30" Height="30"
                                        Foreground="{DynamicResource Dicon.Text}"/>
                        <TextBlock Text="DICON" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold"
                                   FontSize="20" Foreground="{DynamicResource Dicon.Text}"/>
                    </StackPanel>
                    <TextBlock Text="Diagn&#243;stico de Conectividade &#8212; Juntas Especiais 2026"
                               Margin="0,4,0,0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Dicon.Text3}"/>
                    <TextBlock x:Name="txtSaudacao" Margin="0,14,0,0" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource Dicon.Text2}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,18">
                    <Border Style="{DynamicResource Faixa}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="T&#201;CNICO" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource Dicon.Text3}"/>
                            <TextBlock x:Name="txtRailTecnico" Margin="0,2,0,0" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource Dicon.Text}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnTrocarUsuario" Content="Trocar usu&#225;rio"
                            Style="{DynamicResource BotaoFantasma}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Top" Margin="0,18,0,0">
                    <TextBlock Text="NAVEGA&#199;&#195;O" Margin="22,0,0,6" FontFamily="Consolas"
                               FontSize="9" Foreground="{DynamicResource Dicon.Text3}"/>

                    <RadioButton x:Name="navGuia" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M4,3 L13,3 A3,3 0 0 1 16,6 L16,17 L4,17 Z M6,7 L13,7 M6,10 L13,10 M6,13 L11,13"/>
                            <TextBlock Text="Guia de bordo" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="navDiag" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,1 A9,9 0 1 0 10,19 A9,9 0 1 0 10,1 M10,4 A6,6 0 1 1 10,16 A6,6 0 1 1 10,4 M10,7 A3,3 0 1 0 10,13 A3,3 0 1 0 10,7"/>
                            <TextBlock Text="Diagn&#243;stico" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="navAdmin" Style="{DynamicResource NavBotao}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,1 L12,4 L15.5,3.3 L15,7 L18,9 L15,11 L15.5,14.7 L12,14 L10,17 L8,14 L4.5,14.7 L5,11 L2,9 L5,7 L4.5,3.3 L8,4 Z M10,6.5 A2.5,2.5 0 1 0 10,11.5 A2.5,2.5 0 1 0 10,6.5"/>
                            <TextBlock Text="Administra&#231;&#227;o" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Separator Margin="18,14,18,10" Background="{DynamicResource Dicon.Hair}"/>

                    <RadioButton x:Name="navAtualizar" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,3 A7,7 0 1 1 3.5,7.7 M10,3 L10,0.2 M10,3 L6.5,3.2"/>
                            <TextBlock Text="Atualizar dados" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== AREA DE CONTEUDO ========== -->
        <Grid Grid.Column="1" Background="{DynamicResource Dicon.Bg}" Margin="30,26,30,26">

            <!-- ===== LOGIN ===== -->
            <Grid x:Name="viewLogin">
                <Border Style="{DynamicResource Cartao}" Width="440" Padding="34,32"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ContentControl Style="{DynamicResource MarcaDicon}" Width="52" Height="52"
                                            Foreground="{DynamicResource Dicon.Text}"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="240">
                                <TextBlock Text="DICON" FontFamily="{DynamicResource Dicon.Display}"
                                           FontWeight="Bold" FontSize="30" Foreground="{DynamicResource Dicon.Text}"/>
                                <TextBlock Text="Diagn&#243;stico de Conectividade &#8212; Juntas Especiais 2026"
                                           FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text3}"/>
                            </StackPanel>
                        </StackPanel>

                        <Image x:Name="imgLogoLogin" Height="66" Margin="0,22,0,20"
                               HorizontalAlignment="Center"/>

                        <TextBlock Text="Selecione seu nome" Style="{DynamicResource Rotulo}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboTecnico" MinHeight="34" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding nome}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock x:Name="lblPin" Text="PIN do administrador"
                                   Style="{DynamicResource Rotulo}" Margin="0,14,0,6" Visibility="Collapsed"/>
                        <PasswordBox x:Name="txtPin" MinHeight="34" Visibility="Collapsed"/>

                        <TextBlock x:Name="txtLoginMsg" Foreground="{DynamicResource Dicon.Ressalva}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="btnEntrar" Content="Entrar" Style="{DynamicResource BotaoPrimario}"
                                    Padding="30,9"/>
                            <Button x:Name="btnBaixarLista" Content="Baixar lista"
                                    Style="{DynamicResource BotaoSecundario}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== INICIO ===== -->
            <Grid x:Name="viewHome" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                    <TextBlock x:Name="txtHomeTecnico" Style="{DynamicResource TituloTela}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="txtHomeRoteiro" Style="{DynamicResource SubtituloTela}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,14"/>

                    <StackPanel x:Name="painelProgressoRoteiro" Width="320" Margin="0,0,0,20"
                                Visibility="Collapsed">
                        <TextBlock x:Name="txtProgressoRoteiro" HorizontalAlignment="Center"
                                   FontFamily="Consolas" FontSize="11" Margin="0,0,0,5"
                                   Foreground="{DynamicResource Dicon.Text3}"/>
                        <ProgressBar x:Name="prgProgressoRoteiro" Height="5" Minimum="0"
                                     Background="{DynamicResource Dicon.Hair}"
                                     Foreground="{DynamicResource Dicon.Accent}" BorderThickness="0"/>
                    </StackPanel>

                    <StackPanel x:Name="painelAtualizando" Orientation="Horizontal" Margin="0,0,0,16"
                                HorizontalAlignment="Center" Visibility="Collapsed">
                        <mah:ProgressRing x:Name="ringHome" Width="16" Height="16" IsActive="False"
                                          Foreground="{DynamicResource Dicon.Accent}"/>
                        <TextBlock x:Name="txtAtualizandoMsg" Text="Atualizando dados..." Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource Dicon.Text2}"/>
                    </StackPanel>

                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,24">
                        <Border Style="{DynamicResource Cartao}" Margin="0,0,7,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="txtTileDias" Text="&#8212;" Style="{DynamicResource TileNumero}"/>
                                <TextBlock Text="dias de roteiro" Style="{DynamicResource TileRotulo}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Cartao}" Margin="7,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="txtTileLocais" Text="&#8212;" Style="{DynamicResource TileNumero}"/>
                                <TextBlock Text="locais a diagnosticar" Style="{DynamicResource TileRotulo}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Cartao}" Margin="7,0,0,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="txtTileKm" Text="&#8212;" Style="{DynamicResource TileNumero}"/>
                                <TextBlock Text="km de deslocamento" Style="{DynamicResource TileRotulo}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Button x:Name="btnMenuGuia" Content="Abrir guia de bordo"
                            Style="{DynamicResource BotaoPrimario}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Padding="18,12" Margin="0,0,0,10"/>
                    <UniformGrid Rows="1" Columns="2">
                        <Button x:Name="btnMenuDiag" Content="Diagn&#243;stico de conectividade"
                                Style="{DynamicResource BotaoSecundario}" Margin="0,0,5,0"
                                HorizontalContentAlignment="Center"/>
                        <Button x:Name="btnMenuAtualizar" Content="Atualizar dados (com internet)"
                                Style="{DynamicResource BotaoSecundario}" Margin="5,0,0,0"
                                HorizontalContentAlignment="Center"/>
                    </UniformGrid>
                    <Button x:Name="btnMenuAdmin" Content="Administra&#231;&#227;o (limiares)"
                            Style="{DynamicResource BotaoFantasma}" HorizontalAlignment="Center"
                            Margin="0,12,0,0" Visibility="Collapsed"/>

                    <Button x:Name="btnReenviarPendentes" Content="Resultados aguardando envio  -  Reenviar"
                            Style="{DynamicResource BotaoSecundario}" HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Foreground="{DynamicResource Dicon.Ressalva}"
                            Margin="0,16,0,0" Visibility="Collapsed"/>

                    <Image x:Name="imgLogoHome" Height="46" Margin="0,22,0,0" Opacity="0.85"
                           HorizontalAlignment="Center"/>

                    <Border x:Name="painelLogHome" Style="{DynamicResource Faixa}" Margin="0,18,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="ATIVIDADE" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,4"/>
                            <ListBox x:Name="lstLogHome" Background="Transparent" BorderThickness="0"
                                     MaxHeight="132" Foreground="{DynamicResource Dicon.Text2}"
                                     FontFamily="Consolas" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Hora}" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Dicon.Text3}"/>
                                            <TextBlock Text="{Binding Texto}" Foreground="{Binding Cor}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== GUIA DE BORDO ===== -->
            <Grid x:Name="viewGuia" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtGuiaTitulo" Grid.Row="0" Style="{DynamicResource TituloTela}"/>
                <TextBlock x:Name="txtGuiaSub" Grid.Row="1" Style="{DynamicResource SubtituloTela}"
                           Margin="0,6,0,14"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Trechos da viagem" Style="{DynamicResource SecaoTela}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="lstTrechos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Width="18" HorizontalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,6,0,0"
                                                     Fill="{DynamicResource Dicon.Accent}"/>
                                            <Rectangle Width="2" Height="22" Fill="{DynamicResource Dicon.Hair}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Margin="6,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Dicon.Text2}">
                                            <Run Text="{Binding origem}"/><Run Text="  &#8594;  "/>
                                            <Run Text="{Binding destino}" FontWeight="Bold"
                                                 Foreground="{DynamicResource Dicon.Text}"/>
                                            <Run Text="   "/>
                                            <Run Text="{Binding distancia_km}" FontFamily="Consolas"
                                                 Foreground="{DynamicResource Dicon.Text3}"/><Run Text=" km &#183; " Foreground="{DynamicResource Dicon.Text3}"/>
                                            <Run Text="{Binding tempo}" FontFamily="Consolas"
                                                 Foreground="{DynamicResource Dicon.Text3}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Locais para diagn&#243;stico" Style="{DynamicResource SecaoTela}"
                                   Margin="0,18,0,8"/>
                        <ItemsControl x:Name="lstGuiaJuntas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource Cartao}" Margin="0,0,0,10" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Style="{DynamicResource Chip}">
                                                    <TextBlock FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource Dicon.Text}">
                                                        <Run Text="ZE "/><Run Text="{Binding zona_eleitoral}"/>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding municipio_termo}" FontWeight="Bold"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Dicon.Text}"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding locais}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Dicon.Text2}">
                                                                    <Run Text="{Binding tipo_rotulo}"
                                                                         Foreground="{DynamicResource Dicon.Accent}"
                                                                         FontFamily="Consolas" FontSize="11"/>
                                                                    <Run Text="  &#8212;  "/>
                                                                    <Run Text="{Binding nome}" FontWeight="Bold"
                                                                         Foreground="{DynamicResource Dicon.Text}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding endereco}"
                                                                           Foreground="{DynamicResource Dicon.Text3}"
                                                                           FontSize="11" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding tipo_internet}"
                                                                           Foreground="{DynamicResource Dicon.Text3}"
                                                                           FontFamily="Consolas" FontSize="11"/>
                                                                <TextBlock Text="{Binding TesteStatus}"
                                                                           Foreground="{Binding TesteCor}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="{Binding BotaoRodar}"
                                                                    Tag="{Binding}" VerticalAlignment="Center"
                                                                    Margin="12,0,0,0"
                                                                    Style="{DynamicResource BotaoSecundario}"
                                                                    Padding="12,7" FontSize="12"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="txtGuiaSemJunta" Foreground="{DynamicResource Dicon.Text3}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="btnGuiaVoltar" Grid.Row="3" Content="Voltar ao in&#237;cio"
                        HorizontalAlignment="Left" Margin="0,14,0,0"
                        Style="{DynamicResource BotaoFantasma}"/>
            </Grid>

            <!-- ===== DIAGNOSTICO (assistente de 7 passos) ===== -->
            <Grid x:Name="viewDiag" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- cabecalho do assistente -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="txtWizTitulo" Text="Informa&#231;&#227;o do teste"
                               Style="{DynamicResource TituloTela}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtWizPasso" Grid.Column="0" Text="Passo 1 de 7"
                                   FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,12,0" Foreground="{DynamicResource Dicon.Text3}"/>
                        <ProgressBar x:Name="prgWizard" Grid.Column="1" Height="4" Minimum="1" Maximum="7"
                                     Value="1" VerticalAlignment="Center" BorderThickness="0"
                                     Background="{DynamicResource Dicon.Hair}"
                                     Foreground="{DynamicResource Dicon.Accent}"/>
                    </Grid>
                </StackPanel>

                <!-- area dos passos (empilhados por Visibility) -->
                <Grid Grid.Row="1">

                    <!-- PASSO 1: informacao do teste -->
                    <ScrollViewer x:Name="stepInfo" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <Border Style="{DynamicResource Cartao}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="O que este teste faz" Style="{DynamicResource SecaoTela}"
                                           Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text2}"
                                           LineHeight="21">O DICON mede a conectividade do local a partir
                                    deste computador, agora, e classifica a viabilidade da Junta Especial.
                                    O teste tem duas partes:</TextBlock>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Foreground="{DynamicResource Dicon.Text2}" TextWrapping="Wrap"
                                               Margin="0,0,0,6">&#8226;  <Run FontWeight="Bold">Rede local, sem a VPN</Run>  &#8212;  placa de rede, IP que o computador pegou no local, Wi-Fi e a internet do local (ping, DNS, download).</TextBlock>
                                    <TextBlock Foreground="{DynamicResource Dicon.Text2}" TextWrapping="Wrap"
                                               Margin="0,0,0,6">&#8226;  <Run FontWeight="Bold">Com a VPN da Justi&#231;a Eleitoral</Run>  &#8212;  lat&#234;ncia / jitter / perda (ping), banda (iperf3) e tempo de abertura da totaliza&#231;&#227;o (Firefox e Chrome).</TextBlock>
                                </StackPanel>
                                <Border Style="{DynamicResource Faixa}" Margin="0,10,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text3}"
                                               FontSize="12">N&#227;o precisa da VPN agora. Comece pela rede local
                                        &#8212; a ferramenta avisa quando conectar a VPN, no passo 4.</TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- PASSO 2: escolha da Junta Especial -->
                    <ScrollViewer x:Name="stepJunta" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{DynamicResource Cartao}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Junta Especial"
                                               Style="{DynamicResource Rotulo}" VerticalAlignment="Center"
                                               Margin="0,0,12,6"/>
                                    <ComboBox x:Name="cboJunta" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                              MinHeight="32" VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Rotulo}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="btnAtualizar" Grid.Row="0" Grid.Column="2"
                                            Content="Atualizar lista" Margin="10,0,0,6"
                                            Style="{DynamicResource BotaoFantasma}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Local"
                                               Style="{DynamicResource Rotulo}" VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <ComboBox x:Name="cboLocal" Grid.Row="1" Grid.Column="1"
                                              MinHeight="32" VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Rotulo}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <CheckBox x:Name="chkTodasJuntas" Grid.Row="2" Grid.Column="1"
                                              Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="Collapsed"
                                              Content="Incluir Juntas Especiais fora da rota (admin)"/>
                                </Grid>
                            </Border>

                            <Border x:Name="cardDetalheLocal" Style="{DynamicResource Cartao}"
                                    Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Local selecionado" Style="{DynamicResource SecaoTela}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtDetTipo" FontWeight="Bold"
                                               Foreground="{DynamicResource Dicon.Accent}" FontFamily="Consolas"
                                               FontSize="12"/>
                                    <TextBlock x:Name="txtDetNome" FontWeight="Bold" Margin="0,2,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text}"/>
                                    <TextBlock x:Name="txtDetZE" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtDetEndereco" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text2}"/>
                                    <TextBlock x:Name="txtDetUC" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtDetResponsavel" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtDetTelefone" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtDetInternet" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtDetTestado" Margin="0,8,0,0" FontFamily="Consolas"
                                               FontSize="11" TextWrapping="Wrap"/>
                                    <Button x:Name="btnRefazerTeste" Content="Refazer o teste"
                                            Style="{DynamicResource BotaoPrimario}" HorizontalAlignment="Left"
                                            Margin="0,12,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 3: rede local (SEM a VPN do TRE) -->
                    <ScrollViewer x:Name="stepLocal" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{DynamicResource Faixa}">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Ressalva}"
                                           FontSize="12">Ainda <Run FontWeight="Bold">SEM</Run> a VPN do TRE.
                                    Conecte o computador &#224; rede do local (cabo ou Wi-Fi) e rode a checagem.
                                    O IP que o computador receber aqui vai no relat&#243;rio final.</TextBlock>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnRodarFaseLocal" Content="Rodar checagem local"
                                        Style="{DynamicResource BotaoPrimario}" IsEnabled="False"/>
                                <mah:ProgressRing x:Name="ringLocal" Width="18" Height="18" Margin="12,0,0,0"
                                                  IsActive="False" Visibility="Collapsed"
                                                  Foreground="{DynamicResource Dicon.Accent}"/>
                            </StackPanel>

                            <TextBlock x:Name="txtLocDica" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource Dicon.Ressalva}" Visibility="Collapsed"/>

                            <Border x:Name="cardFaseLocal" Style="{DynamicResource Cartao}"
                                    Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Placa de rede" Style="{DynamicResource SecaoTela}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtLocHost" Margin="0,0,0,6" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="dotLan" Width="10" Height="10" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="txtLocLan" FontWeight="Bold" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Dicon.Text}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtLocIp" Margin="18,3,0,0" FontFamily="Consolas"
                                               FontSize="12" Foreground="{DynamicResource Dicon.Text}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtLocGateway" Margin="18,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtLocMascara" Margin="18,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtLocDns" Margin="18,2,0,0" FontFamily="Consolas"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtLocMac" Margin="18,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtLocVel" Margin="18,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Ellipse x:Name="dotWifi" Width="10" Height="10" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="txtLocWifi" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Dicon.Text2}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="cardInternetLocal" Style="{DynamicResource Cartao}"
                                    Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Teste de internet do local" Style="{DynamicResource SecaoTela}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Roda em sequ&#234;ncia: ping &#8594; tracert &#8594; download, transmitindo linha a linha."
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <DockPanel Grid.Column="0">
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse x:Name="dotPing" Width="9" Height="9" Margin="0,0,6,0"
                                                         VerticalAlignment="Center" Fill="{DynamicResource Dicon.Text3}"/>
                                                <TextBlock Text="PING" FontFamily="Consolas" FontSize="9"
                                                           Foreground="{DynamicResource Dicon.Text3}"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource Dicon.SurfaceAlt}"
                                                    BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,6">
                                                <ScrollViewer x:Name="scPing" Height="170"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="lstPing">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="Consolas"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource Dicon.Text2}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </DockPanel>

                                        <DockPanel Grid.Column="2">
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse x:Name="dotTracert" Width="9" Height="9" Margin="0,0,6,0"
                                                         VerticalAlignment="Center" Fill="{DynamicResource Dicon.Text3}"/>
                                                <TextBlock Text="DNS + TRACERT" FontFamily="Consolas" FontSize="9"
                                                           Foreground="{DynamicResource Dicon.Text3}"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource Dicon.SurfaceAlt}"
                                                    BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,6">
                                                <ScrollViewer x:Name="scTracert" Height="170"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="lstTracert">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="Consolas"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource Dicon.Text2}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </DockPanel>

                                        <DockPanel Grid.Column="4">
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse x:Name="dotDownload" Width="9" Height="9" Margin="0,0,6,0"
                                                         VerticalAlignment="Center" Fill="{DynamicResource Dicon.Text3}"/>
                                                <TextBlock Text="DOWNLOAD" FontFamily="Consolas" FontSize="9"
                                                           Foreground="{DynamicResource Dicon.Text3}"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource Dicon.SurfaceAlt}"
                                                    BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,6">
                                                <ScrollViewer x:Name="scDownload" Height="170"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="lstDownload">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="Consolas"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource Dicon.Text2}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </DockPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="cardConectarWifi" Style="{DynamicResource Cartao}"
                                    Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Conectar a uma rede Wi-Fi" Style="{DynamicResource SecaoTela}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Use se o local n&#227;o tiver cabo. A senha fica gravada no
                                               perfil de Wi-Fi do Windows." TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rede (SSID)"
                                                   Style="{DynamicResource Rotulo}" VerticalAlignment="Center"
                                                   Margin="0,0,12,6"/>
                                        <ComboBox x:Name="cboWifiSsid" Grid.Row="0" Grid.Column="1" IsEditable="True"
                                                  MinHeight="32" Margin="0,0,0,6" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Senha"
                                                   Style="{DynamicResource Rotulo}" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <PasswordBox x:Name="pwdWifiSenha" Grid.Row="1" Grid.Column="1"
                                                     MinHeight="32"/>
                                    </Grid>
                                    <Button x:Name="btnConectarWifi" Content="Conectar a esta rede Wi-Fi"
                                            Style="{DynamicResource BotaoSecundario}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0"/>
                                    <TextBlock x:Name="txtWifiStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource Cartao}" Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Sem rede no local? Teste pelo celular"
                                               Style="{DynamicResource SecaoTela}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="chkTetheringCelular"
                                              Content="Testei pela conex&#227;o compartilhada (roteamento) do meu celular"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Operadora" Style="{DynamicResource Rotulo}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ComboBox x:Name="cboOperadora" Grid.Column="1" IsEditable="True"
                                                  MinHeight="32" IsEnabled="False" VerticalContentAlignment="Center">
                                            <sys:String>Claro</sys:String>
                                            <sys:String>Vivo</sys:String>
                                            <sys:String>TIM</sys:String>
                                            <sys:String>Oi</sys:String>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="Qual operadora conseguiu conectar &#8212; vai no relat&#243;rio."
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 4: rodar o diagnostico (COM a VPN do TRE) -->
                    <Grid x:Name="stepDiag" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="txtDiagLocal" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Dicon.Text2}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse x:Name="dotVpn" Width="10" Height="10" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource Dicon.Text3}"/>
                                <TextBlock x:Name="txtDiagVpn" TextWrapping="Wrap" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnRodar" Content="Rodar diagn&#243;stico"
                                        Style="{DynamicResource BotaoPrimario}"/>
                                <Button x:Name="btnAbrirFortiClient" Content="Abrir o FortiClient"
                                        Style="{DynamicResource BotaoSecundario}" Margin="10,0,0,0"
                                        Visibility="Collapsed"/>
                                <Button x:Name="btnReverificarVpn" Content="Verificar novamente"
                                        Style="{DynamicResource BotaoFantasma}" Margin="8,0,0,0"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <mah:ProgressRing x:Name="ringDiag" Grid.Column="0" Width="20" Height="20"
                                              IsActive="False" Visibility="Collapsed"
                                              Foreground="{DynamicResource Dicon.Accent}" Margin="0,0,10,0"/>
                            <ProgressBar x:Name="prgProgresso" Grid.Column="1" Height="4"
                                         VerticalAlignment="Center" Minimum="0" Maximum="100"
                                         IsIndeterminate="False" BorderThickness="0"
                                         Background="{DynamicResource Dicon.Hair}"
                                         Foreground="{DynamicResource Dicon.Accent}"/>
                        </Grid>
                        <Expander Grid.Row="2" Header="Detalhes da execu&#231;&#227;o" Margin="0,14,0,0"
                                  VerticalAlignment="Top" Foreground="{DynamicResource Dicon.Text2}"
                                  IsExpanded="True">
                            <Border Background="{DynamicResource Dicon.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,8,0,0" Height="260">
                                <ListBox x:Name="lstLog" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Dicon.Text2}" FontFamily="Consolas"
                                         FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Hora}"
                                                           Foreground="{DynamicResource Dicon.Text3}"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Texto}" Foreground="{Binding Cor}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Expander>
                    </Grid>

                    <!-- PASSO 5: resultado por metrica -->
                    <ScrollViewer x:Name="stepResultado" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SubtituloTela}" Margin="0,0,0,10"
                                       Text="Ajuste a classifica&#231;&#227;o de uma m&#233;trica se necess&#225;rio &#8212; nesse caso, informe o motivo."/>
                            <TextBlock x:Name="txtMetricasDesativadas" Margin="0,0,0,8" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="11" Visibility="Collapsed"
                                       Foreground="{DynamicResource Dicon.Ressalva}"/>
                            <DataGrid x:Name="dgAvaliacao" Style="{DynamicResource GridMetricas}"
                                      MaxHeight="340" RowHeight="40"
                                      CanUserResizeRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="6" CanUserResize="False" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CorFinal}" CornerRadius="2" Margin="0,3"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}"
                                                        IsReadOnly="True" Width="130"/>
                                    <DataGridTextColumn Header="Valor medido" Binding="{Binding ValorTexto}"
                                                        IsReadOnly="True" Width="110" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="Faixa aceit&#225;vel" Binding="{Binding Regra}"
                                                        IsReadOnly="True" Width="250" FontFamily="Consolas"/>
                                    <DataGridTemplateColumn Header="Sugerida" Width="90" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ClasseAutomatica}"
                                                           Style="{DynamicResource ChipVeredito}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Classifica&#231;&#227;o" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Margin="2" VerticalContentAlignment="Center"
                                                          ItemsSource="{StaticResource classesMetrica}"
                                                          SelectedItem="{Binding ClasseFinal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Motivo do ajuste" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Margin="2" TextWrapping="Wrap" AcceptsReturn="True"
                                                         VerticalContentAlignment="Center"
                                                         Visibility="{Binding Ajustada, Converter={StaticResource boolVis}}"
                                                         Text="{Binding Justificativa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 6: decisao final -->
                    <ScrollViewer x:Name="stepDecisao" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{DynamicResource Cartao}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="barraDecisaoStripe" Grid.Column="0" Width="4"
                                            CornerRadius="2" Margin="0,0,14,0"
                                            Background="{DynamicResource Dicon.Text3}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="DECIS&#195;O FINAL" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="txtDecisaoPalavra" Text="&#8212;"
                                                   FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold"
                                                   FontSize="20" Foreground="{DynamicResource Dicon.Text}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="cboDecisaoFinal" Grid.Column="2" Width="200" MinHeight="32"
                                              VerticalContentAlignment="Center" VerticalAlignment="Center"
                                              ItemsSource="{StaticResource classesDecisao}"/>
                                    <TextBlock x:Name="lblDecisaoRecalc" Grid.Column="3"
                                               Foreground="{DynamicResource Dicon.Text3}"
                                               VerticalAlignment="Center" Margin="14,0" FontFamily="Consolas"
                                               FontSize="11"/>
                                    <TextBlock x:Name="lblJustDecisao" Grid.Column="4" Text="Motivo do ajuste:"
                                               Foreground="{DynamicResource Dicon.Text3}"
                                               VerticalAlignment="Center" Margin="6,0,6,0" FontSize="12"
                                               Visibility="Collapsed"/>
                                    <TextBox x:Name="txtJustDecisao" Grid.Column="5" MinHeight="32"
                                             VerticalContentAlignment="Center" VerticalAlignment="Center"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{DynamicResource SubtituloTela}" Margin="0,12,0,0"
                                       Text="A decis&#227;o final vem do pior caso entre as m&#233;tricas. Voc&#234; pode sobrescrev&#234;-la aqui &#8212; nesse caso, informe o motivo."/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 7: conclusao / exportar -->
                    <ScrollViewer x:Name="stepFim" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <Border Style="{DynamicResource Cartao}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="Diagn&#243;stico conclu&#237;do" Style="{DynamicResource SecaoTela}"/>
                                <TextBlock x:Name="txtFimLocal" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="DECIS&#195;O FINAL" FontFamily="Consolas" FontSize="9"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtFimVeredito" Text="&#8212;" Margin="10,0,0,0"
                                               FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold"
                                               FontSize="20" Foreground="{DynamicResource Dicon.Text}"/>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Dicon.Text3}">O resultado fica salvo
                                    neste computador. <Run FontWeight="Bold">Transmitir</Run> envia agora ao
                                    painel (com internet); sen&#227;o ele vai junto no pr&#243;ximo
                                    "Atualizar dados" / "Reenviar".</TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="btnSalvarResultado" Content="Salvar resultado"
                                            Style="{DynamicResource BotaoSucesso}" IsEnabled="False"/>
                                    <Button x:Name="btnTransmitirResultado" Content="Transmitir resultado"
                                            Style="{DynamicResource BotaoPrimario}" Margin="10,0,0,0"
                                            IsEnabled="False"/>
                                    <Button x:Name="btnExportarPdf" Content="Exportar relat&#243;rio (PDF)"
                                            Style="{DynamicResource BotaoSecundario}" Margin="10,0,0,0"
                                            IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="txtFimStatus" Margin="0,12,0,0" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>

                                <Border Style="{DynamicResource Faixa}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="A&#199;&#213;ES" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimSalvar" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Salvar resultado" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimTransmitir" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Transmitir resultado" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimExportar" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Exportar relat&#243;rio (PDF)" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                </Grid>

                <!-- rodape: navegacao do assistente -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnDiagVoltar" Grid.Column="0" Content="Sair do assistente"
                            Style="{DynamicResource BotaoFantasma}"/>
                    <Button x:Name="btnWizVoltar" Grid.Column="2" Content="Voltar"
                            Style="{DynamicResource BotaoSecundario}" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button x:Name="btnWizProximo" Grid.Column="3" Content="Pr&#243;ximo"
                            Style="{DynamicResource BotaoPrimario}"/>
                </Grid>
            </Grid>

            <!-- ===== ADMIN (LIMIARES) ===== -->
            <Grid x:Name="viewAdmin" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Administra&#231;&#227;o &#8212; limiares de decis&#227;o"
                           Style="{DynamicResource TituloTela}"/>
                <TextBlock Grid.Row="1"
                           Text="Valores que definem vi&#225;vel / ressalva / invi&#225;vel por m&#233;trica. Desmarque &quot;Na bateria&quot; para tirar uma m&#233;trica do teste. Salvos na planilha de configura&#231;&#227;o e usados por todos os computadores."
                           Style="{DynamicResource SubtituloTela}" Margin="0,6,0,14"/>

                <Border Grid.Row="2" Style="{DynamicResource Cartao}" Padding="2">
                    <DataGrid x:Name="dgLimiares" Style="{DynamicResource GridMetricas}"
                              BorderThickness="0" RowHeight="42" MaxHeight="300"
                              CanUserResizeRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Na bateria" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="8,0,0,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Ativo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}"
                                                IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unidade}"
                                                IsReadOnly="True" Width="72" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Dire&#231;&#227;o" Binding="{Binding DirecaoTexto}"
                                                IsReadOnly="True" Width="130"/>
                            <DataGridTemplateColumn Header="Ideal" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                 Text="{Binding LimiarViavel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Limite" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                 Text="{Binding LimiarRessalva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PIN do administrador"
                               Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <PasswordBox x:Name="txtPinAdmin" Grid.Column="1" Width="150" MinHeight="32"/>
                    <Button x:Name="btnSalvarLimiares" Grid.Column="2" Content="Salvar limiares"
                            Margin="12,0,0,0" Style="{DynamicResource BotaoSucesso}"/>
                    <Button x:Name="btnRecarregarLimiares" Grid.Column="3" Content="Recarregar"
                            Margin="8,0,0,0" Style="{DynamicResource BotaoSecundario}"/>
                    <TextBlock x:Name="lblAdminMsg" Grid.Column="4" VerticalAlignment="Center"
                               Margin="14,0,0,0" TextWrapping="Wrap" FontSize="12"/>
                </Grid>

                <Button x:Name="btnAdminVoltar" Grid.Row="4" Content="Voltar ao in&#237;cio"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,14,0,0"
                        Style="{DynamicResource BotaoFantasma}"/>
            </Grid>

        </Grid>
    </Grid>
</mah:MetroWindow>
