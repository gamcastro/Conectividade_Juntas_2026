                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M8,2 L8,11 M4,8 L8,12 L12,8" Stretch="Uniform"
                                                              Width="13" Height="13" Stroke="{DynamicResource Dicon.Accent}"
