<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="DICON &#8212; Diagn&#243;stico de Conectividade"
        Height="760" Width="1120"
        MinHeight="620" MinWidth="940"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        TitleCharacterCasing="Normal"
        SaveWindowPosition="False"
        Background="{DynamicResource Dicon.Bg}"
        Foreground="{DynamicResource Dicon.Text}"
        FontFamily="{DynamicResource Dicon.Body}"
        FontSize="14"
        WindowTitleBrush="{DynamicResource Dicon.Deep}"
        NonActiveWindowTitleBrush="{DynamicResource Dicon.Deep}">

    <Window.Resources>
        <x:Array x:Key="classesMetrica" Type="sys:String">
            <sys:String>viavel</sys:String>
            <sys:String>ressalva</sys:String>
            <sys:String>inviavel</sys:String>
        </x:Array>
        <x:Array x:Key="classesDecisao" Type="sys:String">
            <sys:String>viavel</sys:String>
            <sys:String>viavel_com_ressalva</sys:String>
            <sys:String>inviavel</sys:String>
        </x:Array>
        <BooleanToVisibilityConverter x:Key="boolVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== RAIL DE NAVEGACAO (oculto no login) ========== -->
        <Border x:Name="railNav" Grid.Column="0" Width="214"
                Background="{DynamicResource Dicon.SurfaceAlt}"
                BorderBrush="{DynamicResource Dicon.Hair}" BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Margin="14,14,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Style="{DynamicResource MarcaDicon}" Width="28" Height="28"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Foreground="{DynamicResource Dicon.Text}"/>
                    <Button x:Name="btnRailToggle" Grid.Column="1" Width="30" Height="30"
                            Style="{DynamicResource BotaoFantasma}" Padding="0" ToolTip="Recolher/expandir o menu">
                        <TextBlock x:Name="txtRailToggle" Text="&#171;" FontFamily="Consolas" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <StackPanel x:Name="railCabTexto" DockPanel.Dock="Top" Margin="18,4,18,4">
                    <TextBlock Text="DICON" FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold"
                               FontSize="20" Foreground="{DynamicResource Dicon.Text}"/>
                    <TextBlock Text="Diagn&#243;stico de Conectividade &#8212; Juntas Especiais 2026"
                               Margin="0,2,0,0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Dicon.Text3}"/>
                    <Border x:Name="badgeHomologRail" Visibility="Collapsed" Margin="0,8,0,0"
                            Padding="8,3" CornerRadius="3" HorizontalAlignment="Left"
                            Background="#33E8B93E" BorderBrush="{DynamicResource Dicon.Ressalva}"
                            BorderThickness="1">
                        <TextBlock Text="HOMOLOGA&#199;&#195;O" FontFamily="Consolas" FontSize="9"
                                   FontWeight="Bold" Foreground="{DynamicResource Dicon.Ressalva}"/>
                    </Border>
                    <TextBlock x:Name="txtSaudacao" Margin="0,12,0,0" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource Dicon.Text2}"/>
                </StackPanel>

                <StackPanel x:Name="railRodape" DockPanel.Dock="Bottom" Margin="12,8,12,18">
                    <Border Style="{DynamicResource Faixa}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="T&#201;CNICO" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource Dicon.Text3}"/>
                            <TextBlock x:Name="txtRailTecnico" Margin="0,2,0,0" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource Dicon.Text}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnTrocarUsuario" Content="Trocar usu&#225;rio"
                            Style="{DynamicResource BotaoFantasma}" HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="txtRailVersao" Margin="0,8,0,0" HorizontalAlignment="Center"
                               FontFamily="Consolas" FontSize="9"
                               Foreground="{DynamicResource Dicon.Text3}"/>
                    <Button x:Name="btnAtualizarApp" Margin="0,6,0,0" HorizontalAlignment="Center"
                            Style="{DynamicResource BotaoFantasma}" FontSize="11" Padding="10,4"
                            Foreground="{DynamicResource Dicon.Ressalva}" Visibility="Collapsed"
                            ToolTip="Baixar e instalar a versao mais recente"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Top" Margin="0,14,0,0">
                    <TextBlock x:Name="lblNavSecao" Text="NAVEGA&#199;&#195;O" Margin="22,0,0,6"
                               FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource Dicon.Text3}"/>

                    <RadioButton x:Name="navInicio" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,2 L18,9 L16,9 L16,17 L4,17 L4,9 L2,9 Z M7.5,17 L7.5,11.5 L12.5,11.5 L12.5,17 Z"/>
                            <TextBlock x:Name="lblNavInicio" Text="In&#237;cio" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="navGuia" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M4,3 L13,3 A3,3 0 0 1 16,6 L16,17 L4,17 Z M6,7 L13,7 M6,10 L13,10 M6,13 L11,13"/>
                            <TextBlock x:Name="lblNavGuia" Text="Guia de bordo" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="navLocais" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,1 A6,6 0 0 1 16,7 C16,12 10,19 10,19 C10,19 4,12 4,7 A6,6 0 0 1 10,1 Z M10,4.5 A2.5,2.5 0 1 0 10,9.5 A2.5,2.5 0 1 0 10,4.5"/>
                            <TextBlock x:Name="lblNavLocais" Text="Locais" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="navDiag" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,1 A9,9 0 1 0 10,19 A9,9 0 1 0 10,1 M10,4 A6,6 0 1 1 10,16 A6,6 0 1 1 10,4 M10,7 A3,3 0 1 0 10,13 A3,3 0 1 0 10,7"/>
                            <TextBlock x:Name="lblNavDiag" Text="Diagn&#243;stico" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="navAdmin" Style="{DynamicResource NavBotao}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,1 L12,4 L15.5,3.3 L15,7 L18,9 L15,11 L15.5,14.7 L12,14 L10,17 L8,14 L4.5,14.7 L5,11 L2,9 L5,7 L4.5,3.3 L8,4 Z M10,6.5 A2.5,2.5 0 1 0 10,11.5 A2.5,2.5 0 1 0 10,6.5"/>
                            <TextBlock x:Name="lblNavAdmin" Text="Administra&#231;&#227;o" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Separator Margin="18,14,18,10" Background="{DynamicResource Dicon.Hair}"/>

                    <RadioButton x:Name="navAtualizar" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,3 A7,7 0 1 1 3.5,7.7 M10,3 L10,0.2 M10,3 L6.5,3.2"/>
                            <TextBlock x:Name="lblNavAtualizar" Text="Atualizar dados" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="navAjuda" Style="{DynamicResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,1 A9,9 0 1 0 10,19 A9,9 0 1 0 10,1 M10,2.7 A7.3,7.3 0 1 1 10,17.3 A7.3,7.3 0 1 1 10,2.7 M10,5.2 A1.1,1.1 0 1 0 10,7.4 A1.1,1.1 0 1 0 10,5.2 M9,9 L11,9 L11,14.5 L9,14.5 Z"/>
                            <TextBlock x:Name="lblNavAjuda" Text="Ajuda" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== AREA DE CONTEUDO ========== -->
        <Grid Grid.Column="1" Background="{DynamicResource Dicon.Bg}" Margin="30,26,30,26">

            <!-- ===== LOGIN ===== -->
            <Grid x:Name="viewLogin">
                <Border Style="{DynamicResource Cartao}" Width="440" Padding="34,32"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ContentControl Style="{DynamicResource MarcaDicon}" Width="52" Height="52"
                                            Foreground="{DynamicResource Dicon.Text}"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="240">
                                <TextBlock Text="DICON" FontFamily="{DynamicResource Dicon.Display}"
                                           FontWeight="Bold" FontSize="30" Foreground="{DynamicResource Dicon.Text}"/>
                                <TextBlock Text="Diagn&#243;stico de Conectividade &#8212; Juntas Especiais 2026"
                                           FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text3}"/>
                                <TextBlock x:Name="txtLoginVersao" FontFamily="Consolas" FontSize="10"
                                           Margin="0,2,0,0" Foreground="{DynamicResource Dicon.Text3}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="badgeHomologLogin" Visibility="Collapsed"
                                Margin="0,16,0,0" Padding="12,8" CornerRadius="4"
                                Background="#33E8B93E" BorderBrush="{DynamicResource Dicon.Ressalva}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="AMBIENTE DE HOMOLOGA&#199;&#195;O" FontFamily="Consolas"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource Dicon.Ressalva}"/>
                                <TextBlock Text="Vers&#227;o de teste do admin. Os resultados N&#195;O v&#227;o para a base de produ&#231;&#227;o."
                                           TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource Dicon.Text2}"/>
                            </StackPanel>
                        </Border>

                        <Image x:Name="imgLogoLogin" Height="66" Margin="0,22,0,20"
                               HorizontalAlignment="Center"/>

                        <TextBlock Text="Selecione seu nome" Style="{DynamicResource Rotulo}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboTecnico" MinHeight="34" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding nome}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock x:Name="lblPin" Text="PIN do administrador"
                                   Style="{DynamicResource Rotulo}" Margin="0,14,0,6" Visibility="Collapsed"/>
                        <PasswordBox x:Name="txtPin" MinHeight="34" Visibility="Collapsed"/>

                        <TextBlock x:Name="txtLoginMsg" Foreground="{DynamicResource Dicon.Ressalva}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                            <Button x:Name="btnEntrar" Content="Entrar" Style="{DynamicResource BotaoPrimario}"
                                    Padding="30,9"/>
                            <Button x:Name="btnBaixarLista" Content="Baixar lista"
                                    Style="{DynamicResource BotaoSecundario}" Margin="10,0,0,0"/>
                            <mah:ProgressRing x:Name="ringLogin" Width="22" Height="22" Margin="12,0,0,0"
                                              IsActive="False" Visibility="Collapsed"
                                              Foreground="{DynamicResource Dicon.Accent}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== INICIO ===== -->
            <Grid x:Name="viewHome" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                    <TextBlock x:Name="txtHomeTecnico" Style="{DynamicResource TituloTela}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="txtHomeRoteiro" Style="{DynamicResource SubtituloTela}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,14"/>

                    <StackPanel x:Name="painelProgressoRoteiro" Width="320" Margin="0,0,0,20"
                                Visibility="Collapsed">
                        <TextBlock x:Name="txtProgressoRoteiro" HorizontalAlignment="Center"
                                   FontFamily="Consolas" FontSize="11" Margin="0,0,0,5"
                                   Foreground="{DynamicResource Dicon.Text3}"/>
                        <ProgressBar x:Name="prgProgressoRoteiro" Height="5" Minimum="0"
                                     Background="{DynamicResource Dicon.Hair}"
                                     Foreground="{DynamicResource Dicon.Accent}" BorderThickness="0"/>
                    </StackPanel>

                    <StackPanel x:Name="painelAtualizando" Orientation="Horizontal" Margin="0,0,0,16"
                                HorizontalAlignment="Center" Visibility="Collapsed">
                        <mah:ProgressRing x:Name="ringHome" Width="16" Height="16" IsActive="False"
                                          Foreground="{DynamicResource Dicon.Accent}"/>
                        <TextBlock x:Name="txtAtualizandoMsg" Text="Atualizando dados..." Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource Dicon.Text2}"/>
                    </StackPanel>

                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,24">
                        <Border Style="{DynamicResource Cartao}" Margin="0,0,7,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="txtTileDias" Text="&#8212;" Style="{DynamicResource TileNumero}"/>
                                <TextBlock Text="dias de roteiro" Style="{DynamicResource TileRotulo}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Cartao}" Margin="7,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="txtTileLocais" Text="&#8212;" Style="{DynamicResource TileNumero}"/>
                                <TextBlock Text="locais a diagnosticar" Style="{DynamicResource TileRotulo}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Cartao}" Margin="7,0,0,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="txtTileKm" Text="&#8212;" Style="{DynamicResource TileNumero}"/>
                                <TextBlock Text="km de deslocamento" Style="{DynamicResource TileRotulo}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Button x:Name="btnMenuGuia" Content="Abrir guia de bordo"
                            Style="{DynamicResource BotaoPrimario}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Padding="18,12" Margin="0,0,0,10"/>
                    <UniformGrid Rows="1" Columns="2">
                        <Button x:Name="btnMenuDiag" Content="Diagn&#243;stico de conectividade"
                                Style="{DynamicResource BotaoSecundario}" Margin="0,0,5,0"
                                HorizontalContentAlignment="Center"/>
                        <Button x:Name="btnMenuAtualizar" Content="Atualizar dados (com internet)"
                                Style="{DynamicResource BotaoSecundario}" Margin="5,0,0,0"
                                HorizontalContentAlignment="Center"/>
                    </UniformGrid>
                    <Button x:Name="btnMenuAdmin" Content="Administra&#231;&#227;o (limiares)"
                            Style="{DynamicResource BotaoFantasma}" HorizontalAlignment="Center"
                            Margin="0,12,0,0" Visibility="Collapsed"/>

                    <Button x:Name="btnReenviarPendentes" Content="Resultados aguardando envio  -  Reenviar"
                            Style="{DynamicResource BotaoSecundario}" HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Foreground="{DynamicResource Dicon.Ressalva}"
                            Margin="0,16,0,0" Visibility="Collapsed"/>

                    <Image x:Name="imgLogoHome" Height="46" Margin="0,22,0,0" Opacity="0.85"
                           HorizontalAlignment="Center"/>

                    <Border x:Name="painelLogHome" Style="{DynamicResource Faixa}" Margin="0,18,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="ATIVIDADE" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,4"/>
                            <ListBox x:Name="lstLogHome" Background="Transparent" BorderThickness="0"
                                     MaxHeight="132" Foreground="{DynamicResource Dicon.Text2}"
                                     FontFamily="Consolas" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Hora}" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Dicon.Text3}"/>
                                            <TextBlock Text="{Binding Texto}" Foreground="{Binding Cor}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== GUIA DE BORDO ===== -->
            <Grid x:Name="viewGuia" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtGuiaTitulo" Grid.Row="0" Style="{DynamicResource TituloTela}"/>
                <TextBlock x:Name="txtGuiaSub" Grid.Row="1" Style="{DynamicResource SubtituloTela}"
                           Margin="0,6,0,14"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Locais para diagn&#243;stico" Style="{DynamicResource SecaoTela}"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="lstGuiaJuntas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14" CornerRadius="8" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Dicon.Surface}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Hair}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TodasTestadas}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Dicon.ViavelDim}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Viavel}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Style="{DynamicResource Chip}">
                                                    <TextBlock FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource Dicon.Text}">
                                                        <Run Text="ZE "/><Run Text="{Binding zona_eleitoral}"/>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding municipio_termo}" FontWeight="Bold"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Dicon.Text}"/>
                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource Dicon.Viavel}"
                                                           Visibility="{Binding TodasTestadas, Converter={StaticResource boolVis}}">
                                                    <Run Text="&#10003; CONCLU&#205;DA"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding locais}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,4" Padding="10,7" CornerRadius="6" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Testado}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Dicon.ViavelDim}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Dicon.Viavel}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Dicon.Text2}">
                                                                    <Run Text="{Binding tipo_rotulo}"
                                                                         Foreground="{DynamicResource Dicon.Accent}"
                                                                         FontFamily="Consolas" FontSize="11"/>
                                                                    <Run Text="  &#8212;  "/>
                                                                    <Run Text="{Binding nome}" FontWeight="Bold"
                                                                         Foreground="{DynamicResource Dicon.Text}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding endereco}"
                                                                           Foreground="{DynamicResource Dicon.Text3}"
                                                                           FontSize="11" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding tipo_internet}"
                                                                           Foreground="{DynamicResource Dicon.Text3}"
                                                                           FontFamily="Consolas" FontSize="11"/>
                                                                <TextBlock Text="{Binding TesteStatus}"
                                                                           Foreground="{Binding TesteCor}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="{Binding BotaoRodar}"
                                                                    Tag="{Binding}" VerticalAlignment="Center"
                                                                    Margin="12,0,0,0"
                                                                    Style="{DynamicResource BotaoSecundario}"
                                                                    Padding="12,7" FontSize="12"/>
                                                        </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="txtGuiaSemJunta" Foreground="{DynamicResource Dicon.Text3}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="btnGuiaVoltar" Grid.Row="3" Content="Voltar ao in&#237;cio"
                        HorizontalAlignment="Left" Margin="0,14,0,0"
                        Style="{DynamicResource BotaoFantasma}"/>
            </Grid>

            <!-- ===== LOCAIS DE VISTORIA (referencia + busca/filtros) ===== -->
            <Grid x:Name="viewLocais" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Locais de vistoria" Style="{DynamicResource TituloTela}"/>
                <TextBlock x:Name="txtLocaisSub" Grid.Row="1" Style="{DynamicResource SubtituloTela}"
                           Margin="0,6,0,12"/>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Buscar" Style="{DynamicResource Rotulo}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtBuscaLocais" Grid.Column="1" MinHeight="32"
                             VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboFiltroZE" Grid.Column="2" MinHeight="32" Width="130" Margin="10,0,0,0"
                              VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboFiltroMun" Grid.Column="3" MinHeight="32" Width="210" Margin="10,0,0,0"
                              VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="txtLocaisContagem" Grid.Column="4" VerticalAlignment="Center"
                               Margin="14,0,0,0" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Dicon.Text3}"/>
                </Grid>

                <DataGrid x:Name="dgLocais" Grid.Row="3" Style="{DynamicResource GridMetricas}"
                          RowHeight="34" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserResizeRows="False" HeadersVisibility="Column"
                          SelectionUnit="FullRow" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ZE" Binding="{Binding zona_eleitoral}" Width="50"/>
                        <DataGridTextColumn Header="Munic&#237;pio" Binding="{Binding municipio_termo}" Width="150"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoRotulo}" Width="90"/>
                        <DataGridTextColumn Header="Local" Binding="{Binding nome}" Width="*"/>
                        <DataGridTextColumn Header="Internet" Binding="{Binding tipo_internet}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="btnLocaisVoltar" Grid.Row="4" Content="Voltar ao in&#237;cio"
                        HorizontalAlignment="Left" Margin="0,14,0,0"
                        Style="{DynamicResource BotaoFantasma}"/>
            </Grid>

            <!-- ===== LOCAL DE VISTORIA - FICHA COMPLETA (tela dedicada) ===== -->
            <Grid x:Name="viewLocalDetalhe" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="btnLocalDetalheVoltar" Grid.Row="0"
                        Content="&#8249; Voltar aos locais" HorizontalAlignment="Left"
                        Style="{DynamicResource BotaoFantasma}"/>

                <StackPanel Grid.Row="1" Margin="0,14,0,10">
                    <TextBlock x:Name="txtLDPTipo" FontFamily="Consolas" FontSize="10"
                               Foreground="{DynamicResource Dicon.Text3}"/>
                    <TextBlock x:Name="txtLDPNome" FontFamily="{DynamicResource Dicon.Display}"
                               FontWeight="Bold" FontSize="26" TextWrapping="Wrap"
                               Foreground="{DynamicResource Dicon.Text}"/>
                    <TextBlock x:Name="txtLDPZE" Margin="0,4,0,0" FontSize="13"
                               Foreground="{DynamicResource Dicon.Text2}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- STATUS: testado / salvo / transmitido / relatorio exportado / GEL anexado -->
                        <Border Style="{DynamicResource Cartao}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="STATUS DO LOCAL" FontFamily="Consolas" FontSize="9"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Border Background="{DynamicResource Dicon.SurfaceAlt}" CornerRadius="12" Padding="12,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="dotLdTestado" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Testado" FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Dicon.SurfaceAlt}" CornerRadius="12" Padding="12,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="dotLdSalvo" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Salvo" FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Dicon.SurfaceAlt}" CornerRadius="12" Padding="12,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="dotLdTransmitido" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Transmitido" FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Dicon.SurfaceAlt}" CornerRadius="12" Padding="12,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="dotLdExportado" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Relat&#243;rio exportado" FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Dicon.SurfaceAlt}" CornerRadius="12" Padding="12,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="dotLdGel" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Formul&#225;rio GEL" FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock x:Name="txtLdStatusInfo" Margin="0,4,0,0" FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text3}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="btnLdRelatorio" Content="Abrir relat&#243;rio completo (PDF)"
                                            Style="{DynamicResource BotaoSecundario}"/>
                                    <TextBlock x:Name="txtLdRelatStatus" Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- anexo: formulario do GEL (a qualquer tempo, nao so no teste) -->
                        <Border x:Name="cardGel" Style="{DynamicResource Cartao}" Padding="20,18" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="FORMUL&#193;RIO DO GEL" FontFamily="Consolas" FontSize="9"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,10"
                                           Text="Anexe o PDF da vistoria do GEL deste local. O DICON extrai as coordenadas (mapa no relat&#243;rio), o suporte ao link local e os dados el&#233;tricos. Voc&#234; confere antes de registrar. Fica salvo no local e entra no relat&#243;rio quando o diagn&#243;stico for feito/exportado."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnAnexarGel" Content="Anexar formul&#225;rio GEL (PDF)"
                                            Style="{DynamicResource BotaoSecundario}"/>
                                    <Button x:Name="btnGelRemover" Content="Remover anexo"
                                            Style="{DynamicResource BotaoFantasma}" Margin="8,0,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtGelStatus" Margin="12,0,0,0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                </StackPanel>

                                <Border x:Name="panelGelConf" Style="{DynamicResource Faixa}" Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Confira e ajuste antes de registrar" FontFamily="Consolas"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,8"/>

                                        <!-- Coordenadas -->
                                        <TextBlock Text="COORDENADAS" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,4,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Latitude" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelLat" Grid.Row="0" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Longitude" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelLong" Grid.Row="0" Grid.Column="3" Margin="0,3,0,3" MinHeight="30" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Precis&#227;o (m)" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelPrec" Grid.Row="1" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- Tipo do local -->
                                        <TextBlock Text="TIPO DO LOCAL" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,10,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Esfera administrativa" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelEsfera" Grid.Row="0" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Localiza&#231;&#227;o" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelLocalizacao" Grid.Row="0" Grid.Column="3" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tipo de local" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelTipoLocal" Grid.Row="1" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- Infraestrutura -->
                                        <TextBlock Text="INFRAESTRUTURA" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,10,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Salas necess&#225;rias" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelSalas" Grid.Row="0" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Abastecimento de &#225;gua" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelAgua" Grid.Row="0" Grid.Column="3" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Climatiza&#231;&#227;o / ventila&#231;&#227;o" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelClima" Grid.Row="1" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Ilumina&#231;&#227;o" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelIluminacao" Grid.Row="1" Grid.Column="3" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="&#193;gua pot&#225;vel" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelAguaPot" Grid.Row="2" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Pr&#233;dio em reforma" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelReforma" Grid.Row="2" Grid.Column="3" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- Instalacoes eletricas -->
                                        <TextBlock Text="INSTALA&#199;&#213;ES EL&#201;TRICAS" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,10,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Quadro de energia" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelQuadro" Grid.Row="0" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Energia el&#233;trica" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelEnergia" Grid.Row="0" Grid.Column="3" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tomadas" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelTomadas" Grid.Row="1" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Tens&#227;o" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelTensao" Grid.Row="1" Grid.Column="3" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Extens&#227;o el&#233;trica" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelExtensao" Grid.Row="2" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- Suporte ao link local -->
                                        <TextBlock Text="SUPORTE AO LINK LOCAL" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,10,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Empresa / t&#233;cnico" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelSupNome" Grid.Row="0" Grid.Column="1" Margin="0,3,12,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Telefone" Style="{DynamicResource Rotulo}" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                            <TextBox x:Name="txtGelSupTel" Grid.Row="0" Grid.Column="3" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="btnGelRegistrar" Content="Registrar"
                                                    Style="{DynamicResource BotaoPrimario}" Padding="18,7"/>
                                            <Button x:Name="btnGelCancelar" Content="Cancelar"
                                                    Style="{DynamicResource BotaoFantasma}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="txtGelResumo" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Dicon.Viavel}" Visibility="Collapsed"/>

                                <!-- fotos da vistoria (baixadas do GEL web) -->
                                <TextBlock Text="FOTOS DA VISTORIA" FontFamily="Consolas" FontSize="9"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,16,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Dicon.Text3}"
                                           Text="As fotos tiradas no app do GEL ficam s&#243; no GEL web. Baixe-as l&#225; e adicione aqui (JPG/PNG) &#8212; elas entram numa se&#231;&#227;o do relat&#243;rio do DICON (reduzidas)."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnGelAddFotos" Content="Adicionar fotos"
                                            Style="{DynamicResource BotaoSecundario}"/>
                                    <Button x:Name="btnGelFotoRemover" Content="Remover selecionada"
                                            Style="{DynamicResource BotaoFantasma}" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="txtGelFotosResumo" Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource Dicon.Text3}"/>
                                </StackPanel>
                                <ListBox x:Name="lstGelFotos" Margin="0,8,0,0" MaxHeight="140"
                                         FontFamily="Consolas" FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Cartao}" Padding="20,18" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="DADOS DO LOCAL" FontFamily="Consolas" FontSize="9"
                                           Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtLDPEndereco" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text}"/>
                                <TextBlock x:Name="txtLDPInternet" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Dicon.Text}"/>
                                <TextBlock x:Name="txtLDPUC" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Dicon.Text}"/>
                                <TextBlock x:Name="txtLDPResponsavel" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Dicon.Text}"/>
                                <TextBlock x:Name="txtLDPTelefone" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Dicon.Text}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="cardLDPCompleto" Style="{DynamicResource Cartao}" Padding="20,18"
                                Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="FICHA COMPLETA (texto do roteiro)" FontFamily="Consolas"
                                           FontSize="9" Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtLDPCompleto" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="12" LineHeight="18"
                                           Foreground="{DynamicResource Dicon.Text2}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== DIAGNOSTICO (assistente de 6 passos) ===== -->
            <Grid x:Name="viewDiag" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- cabecalho do assistente -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="txtWizTitulo" Text="Informa&#231;&#227;o do teste"
                               Style="{DynamicResource TituloTela}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtWizPasso" Grid.Column="0" Text="Passo 1 de 6"
                                   FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,12,0" Foreground="{DynamicResource Dicon.Text3}"/>
                        <ProgressBar x:Name="prgWizard" Grid.Column="1" Height="4" Minimum="1" Maximum="6"
                                     Value="1" VerticalAlignment="Center" BorderThickness="0"
                                     Background="{DynamicResource Dicon.Hair}"
                                     Foreground="{DynamicResource Dicon.Accent}"/>
                    </Grid>
                </StackPanel>

                <!-- area dos passos (empilhados por Visibility) -->
                <Grid Grid.Row="1">

                    <!-- PASSO 1: informacao do teste -->
                    <ScrollViewer x:Name="stepInfo" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <Border Style="{DynamicResource Cartao}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="O que este teste faz" Style="{DynamicResource SecaoTela}"
                                           Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text2}"
                                           LineHeight="21">O DICON mede a conectividade do local a partir
                                    deste computador, agora, e classifica a viabilidade da Junta Especial.
                                    O teste tem duas partes:</TextBlock>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Foreground="{DynamicResource Dicon.Text2}" TextWrapping="Wrap"
                                               Margin="0,0,0,6">&#8226;  <Run FontWeight="Bold">Rede local, sem a VPN</Run>  &#8212;  placa de rede, IP que o computador pegou no local, Wi-Fi e a internet do local (ping, DNS, download).</TextBlock>
                                    <TextBlock Foreground="{DynamicResource Dicon.Text2}" TextWrapping="Wrap"
                                               Margin="0,0,0,6">&#8226;  <Run FontWeight="Bold">Com a VPN da Justi&#231;a Eleitoral</Run>  &#8212;  lat&#234;ncia / jitter / perda (ping), banda pela VPN e tempo de abertura da totaliza&#231;&#227;o (Firefox e Chrome).</TextBlock>
                                </StackPanel>
                                <Border Style="{DynamicResource Faixa}" Margin="0,10,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text3}"
                                               FontSize="12">N&#227;o precisa da VPN agora. Comece pela rede local
                                        &#8212; a ferramenta avisa quando conectar a VPN, no passo 4.</TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- PASSO 2: escolha da Junta Especial -->
                    <ScrollViewer x:Name="stepJunta" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{DynamicResource Cartao}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Junta Especial"
                                               Style="{DynamicResource Rotulo}" VerticalAlignment="Center"
                                               Margin="0,0,12,6"/>
                                    <ComboBox x:Name="cboJunta" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                              MinHeight="32" VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Rotulo}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="btnAtualizar" Grid.Row="0" Grid.Column="2"
                                            Content="Atualizar lista" Margin="10,0,0,6"
                                            Style="{DynamicResource BotaoFantasma}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Local"
                                               Style="{DynamicResource Rotulo}" VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <ComboBox x:Name="cboLocal" Grid.Row="1" Grid.Column="1"
                                              MinHeight="32" VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Rotulo}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <CheckBox x:Name="chkTodasJuntas" Grid.Row="2" Grid.Column="1"
                                              Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="Collapsed"
                                              Content="Incluir Juntas Especiais fora da rota (admin)"/>
                                </Grid>
                            </Border>

                            <Border x:Name="cardDetalheLocal" Style="{DynamicResource Cartao}"
                                    Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Local selecionado" Style="{DynamicResource SecaoTela}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtDetTipo" FontWeight="Bold"
                                               Foreground="{DynamicResource Dicon.Accent}" FontFamily="Consolas"
                                               FontSize="12"/>
                                    <TextBlock x:Name="txtDetNome" FontWeight="Bold" Margin="0,2,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Text}"/>
                                    <TextBlock x:Name="txtDetZE" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtDetEndereco" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text2}"/>
                                    <TextBlock x:Name="txtDetUC" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtDetResponsavel" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtDetTelefone" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtDetInternet" Margin="0,2,0,0" FontFamily="Consolas"
                                               FontSize="11" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtDetTestado" Margin="0,8,0,0" FontFamily="Consolas"
                                               FontSize="11" TextWrapping="Wrap"/>
                                    <Button x:Name="btnRefazerTeste" Content="Refazer o teste"
                                            Style="{DynamicResource BotaoPrimario}" HorizontalAlignment="Left"
                                            Margin="0,12,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 3: meios de conexao (cada card roda a checagem completa) -->
                    <ScrollViewer x:Name="stepLocal" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{DynamicResource Faixa}">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Dicon.Ressalva}"
                                           FontSize="12">Cada meio (LAN, Wi-Fi, Celular) roda a checagem <Run FontWeight="Bold">completa</Run>
                                    &#8212; Fase 1 (rede local, sem VPN) e Fase 2 (com a VPN do TRE) &#8212; na janela que
                                    abre no bot&#227;o do card. Uma checagem por vez. O IP recebido em cada meio vai no relat&#243;rio.</TextBlock>
                            </Border>

                            <TextBlock x:Name="txtLocHost" Margin="0,12,0,0" FontFamily="Consolas"
                                       FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                       Visibility="Collapsed"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <mah:ProgressRing x:Name="ringMeios" Grid.Column="0" Width="18" Height="18"
                                                  Margin="0,0,10,0" IsActive="False" Visibility="Collapsed"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource Dicon.Accent}"/>
                                <TextBlock x:Name="txtLocEscolha" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Dicon.Text2}"
                                           Text="Clique no card do meio que vai testar (fica com a borda azul) para liberar a checagem. Marque os que nao se aplicam."/>
                                <Button x:Name="btnRelerPlacas" Grid.Column="2" Width="32" Height="32" Margin="10,0,0,0"
                                        Style="{DynamicResource BotaoFantasma}" Padding="0"
                                        ToolTip="Reler TODAS as placas (LAN + Wi-Fi). Para atualizar s&#243; uma, use o &#8635; do card.">
                                    <TextBlock Text="&#8635;" FontSize="17" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <Border x:Name="cardMeioAviso" Style="{DynamicResource Faixa}" Margin="0,10,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txtMeioAviso" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Dicon.Ressalva}"/>
                            </Border>

                            <!-- escolha do meio: 3 cartoes lado a lado -->
                            <Grid x:Name="cardFaseLocal" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="cardLan" Grid.Column="0" Style="{DynamicResource Cartao}"
                                        Padding="16,14" VerticalAlignment="Stretch">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="numLan" Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource Dicon.Text3}">
                                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="LAN" FontFamily="{DynamicResource Dicon.Display}"
                                                       FontWeight="Bold" FontSize="19" Margin="0,0,0,2"
                                                       Foreground="{DynamicResource Dicon.Text}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <mah:ProgressRing x:Name="ringRelerLan" Width="14" Height="14" Margin="0,0,4,0"
                                                                  IsActive="False" Visibility="Collapsed"
                                                                  Foreground="{DynamicResource Dicon.Accent}"/>
                                                <Button x:Name="btnRelerLan" Width="26" Height="26" Padding="0"
                                                        Style="{DynamicResource BotaoFantasma}"
                                                        ToolTip="Reler s&#243; a placa cabeada (LAN) &#8212; n&#227;o mexe no card Wi-Fi">
                                                    <TextBlock Text="&#8635;" FontSize="14" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="badgeLan" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,6" Foreground="{DynamicResource Dicon.Text3}"
                                                   Text="NAO TESTADO"/>
                                        <Button x:Name="btnCheckLan" Content="Rodar checagem" IsEnabled="False"
                                                Style="{DynamicResource BotaoPrimario}" HorizontalAlignment="Left"
                                                Margin="0,2,0,0" Padding="16,7"/>
                                        <CheckBox x:Name="chkNaLan" Margin="0,10,0,0" FontSize="11"
                                                  Content="Nao se aplica a este local"/>
                                        <TextBlock x:Name="txtNaMotivoCardLan" Margin="0,6,0,0" FontSize="11"
                                                   TextWrapping="Wrap" Visibility="Collapsed"
                                                   Foreground="{DynamicResource Dicon.Inviavel}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Ellipse x:Name="dotLan" Width="10" Height="10" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Fill="{DynamicResource Dicon.Text3}"/>
                                            <TextBlock x:Name="txtLocLan" FontWeight="Bold" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Dicon.Text}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtLocIp" Margin="18,6,0,0" FontFamily="Consolas"
                                                   FontSize="12" Foreground="{DynamicResource Dicon.Text}"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocGateway" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocMascara" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocDns" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocMac" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocVel" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocOrigem" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}"
                                                   Visibility="Collapsed"/>
                                        <Border x:Name="cardLocJE" Margin="18,8,0,0" HorizontalAlignment="Left"
                                                Background="{DynamicResource Dicon.ViavelDim}" CornerRadius="4"
                                                Padding="8,3" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource Dicon.Viavel}"/>
                                                <TextBlock Text="REDE DA JUSTI&#199;A ELEITORAL" FontFamily="Consolas"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource Dicon.Viavel}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="cardWifiPlaca" Grid.Column="2" Style="{DynamicResource Cartao}"
                                        Padding="16,14" VerticalAlignment="Stretch">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="numWifi" Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource Dicon.Text3}">
                                                <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="WI-FI" FontFamily="{DynamicResource Dicon.Display}"
                                                       FontWeight="Bold" FontSize="19" Margin="0,0,0,2"
                                                       Foreground="{DynamicResource Dicon.Text}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <mah:ProgressRing x:Name="ringRelerWifi" Width="14" Height="14" Margin="0,0,4,0"
                                                                  IsActive="False" Visibility="Collapsed"
                                                                  Foreground="{DynamicResource Dicon.Accent}"/>
                                                <Button x:Name="btnRelerWifi" Width="26" Height="26" Padding="0"
                                                        Style="{DynamicResource BotaoFantasma}"
                                                        ToolTip="Reler s&#243; a placa Wi-Fi &#8212; n&#227;o mexe no card LAN">
                                                    <TextBlock Text="&#8635;" FontSize="14" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="badgeWifi" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,6" Foreground="{DynamicResource Dicon.Text3}"
                                                   Text="NAO TESTADO"/>
                                        <Button x:Name="btnCheckWifi" Content="Rodar checagem" IsEnabled="False"
                                                Style="{DynamicResource BotaoPrimario}" HorizontalAlignment="Left"
                                                Margin="0,2,0,0" Padding="16,7"/>
                                        <CheckBox x:Name="chkNaWifi" Margin="0,10,0,0" FontSize="11"
                                                  Content="Nao se aplica a este local"/>
                                        <TextBlock x:Name="txtNaMotivoCardWifi" Margin="0,6,0,0" FontSize="11"
                                                   TextWrapping="Wrap" Visibility="Collapsed"
                                                   Foreground="{DynamicResource Dicon.Inviavel}"/>
                                        <TextBlock x:Name="txtWifiSelDica" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                                   Visibility="Collapsed" Foreground="{DynamicResource Dicon.Text3}"
                                                   Text="Se a rede conectada e a Wi-Fi do proprio local, clique neste card para seleciona-lo."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Ellipse x:Name="dotWifi" Width="10" Height="10" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Fill="{DynamicResource Dicon.Text3}"/>
                                            <TextBlock x:Name="txtLocWifi" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtLocWifiIp" Margin="18,6,0,0" FontFamily="Consolas"
                                                   FontSize="12" Foreground="{DynamicResource Dicon.Text}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocWifiGw" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocWifiMask" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocWifiMac" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocWifiVel" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocWifiBanda" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocWifiOrigem" Margin="18,2,0,0" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="txtLocWifiDet" Margin="18,4,0,0" FontFamily="Consolas"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="cardCelular" Grid.Column="4" Style="{DynamicResource Cartao}"
                                        Padding="16,14" VerticalAlignment="Stretch">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="numCel" Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource Dicon.Text3}">
                                                <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="CELULAR" FontFamily="{DynamicResource Dicon.Display}"
                                                       FontWeight="Bold" FontSize="19" Margin="0,0,0,2"
                                                       Foreground="{DynamicResource Dicon.Text}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <mah:ProgressRing x:Name="ringRelerCel" Width="14" Height="14" Margin="0,0,4,0"
                                                                  IsActive="False" Visibility="Collapsed"
                                                                  Foreground="{DynamicResource Dicon.Accent}"/>
                                                <Button x:Name="btnRelerCel" Width="26" Height="26" Padding="0"
                                                        Style="{DynamicResource BotaoFantasma}"
                                                        ToolTip="Reler a placa Wi-Fi (o roteamento do celular usa a mesma placa)">
                                                    <TextBlock Text="&#8635;" FontSize="14" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="badgeCelular" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,6" Foreground="{DynamicResource Dicon.Text3}"
                                                   Text="NAO TESTADO"/>
                                        <Button x:Name="btnCheckCelular" Content="Rodar checagem" IsEnabled="False"
                                                Style="{DynamicResource BotaoPrimario}" HorizontalAlignment="Left"
                                                Margin="0,2,0,0" Padding="16,7"/>
                                        <CheckBox x:Name="chkNaCelular" Margin="0,10,0,0" FontSize="11"
                                                  Content="Nao se aplica a este local"/>
                                        <TextBlock x:Name="txtNaMotivoCardCelular" Margin="0,6,0,0" FontSize="11"
                                                   TextWrapping="Wrap" Visibility="Collapsed"
                                                   Foreground="{DynamicResource Dicon.Inviavel}"/>
                                        <TextBlock x:Name="txtCelDica" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource Dicon.Text3}"
                                                   Text="Se a rede Wi-Fi conectada e o roteamento do seu celular, clique neste card para seleciona-lo e informe a operadora."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Operadora" Style="{DynamicResource Rotulo}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="cboOperadoraCel" IsEditable="True" MinHeight="32" Width="150"
                                                      VerticalContentAlignment="Center">
                                                <sys:String>Claro</sys:String>
                                                <sys:String>Vivo</sys:String>
                                                <sys:String>TIM</sys:String>
                                                <sys:String>Oi</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock x:Name="txtLocCel" Margin="0,8,0,0" FontFamily="Consolas"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Dicon.Text3}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border x:Name="cardNaJustif" Style="{DynamicResource Cartao}" Padding="18,16"
                                    Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Meio que N&#195;O se aplica a este local" Style="{DynamicResource SecaoTela}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtNaJustifMeio" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Motivo mais comum? Escolha uma sugest&#227;o ou use &#171;Outro&#187; pra digitar:"
                                               FontSize="12" Foreground="{DynamicResource Dicon.Text2}" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="wrapNaSugestoes" Margin="0,0,0,10"/>
                                    <TextBlock Text="Justificativa (obrigat&#243;ria &#8212; vai no relat&#243;rio; o meio fica INVI&#193;VEL):"
                                               FontSize="12" Foreground="{DynamicResource Dicon.Text2}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtNaJustif" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True"
                                             AcceptsTab="False" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Padding="8,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="btnNaRegistrar" Content="Registrar"
                                                Style="{DynamicResource BotaoPrimario}" Padding="20,7"/>
                                        <Button x:Name="btnNaCancelar" Content="Cancelar"
                                                Style="{DynamicResource BotaoFantasma}" Margin="10,0,0,0" Padding="16,7"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="cardRecMeios" Style="{DynamicResource Faixa}" Margin="0,14,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="txtRecMeios" TextWrapping="Wrap" FontSize="13"
                                               Foreground="{DynamicResource Dicon.Text}"/>
                                    <TextBlock x:Name="txtRecMeiosObs" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Dicon.Ressalva}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="cardWifiBandeja" Style="{DynamicResource Cartao}"
                                    Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Precisa de Wi-Fi neste local?" Style="{DynamicResource SecaoTela}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource Dicon.Text2}"><Run
                                               Text="Conecte pela bandeja do Windows &#8212; clique no &#237;cone de rede perto do rel&#243;gio, escolha a rede e informe a senha. Depois clique no bot&#227;o "/><Run
                                               Text="&#8635;" FontWeight="Bold" Foreground="{DynamicResource Dicon.Accent}"/><Run
                                               Text=" no canto superior direito para reler as placas e atualizar o status do Wi-Fi."/></TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="txtMeiosPendentes" TextWrapping="Wrap" FontSize="12" Margin="4,14,0,0"
                                       Foreground="{DynamicResource Dicon.Ressalva}" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 4: resultado por metrica -->
                    <ScrollViewer x:Name="stepResultado" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SubtituloTela}" Margin="0,0,0,10"
                                       Text="Cada aba &#233; um meio testado. Ajuste a classifica&#231;&#227;o de uma m&#233;trica se necess&#225;rio &#8212; nesse caso, informe o motivo."/>

                            <Border x:Name="cardSugestaoResultado" Style="{DynamicResource Faixa}" Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txtSugestaoResultado" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Dicon.Text}"/>
                            </Border>

                            <Border x:Name="cardNaResumo" Style="{DynamicResource Faixa}" Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txtNaResumo" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Dicon.Inviavel}"/>
                            </Border>

                            <TextBlock x:Name="txtSemMedicoes" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="13"
                                       Visibility="Collapsed" Foreground="{DynamicResource Dicon.Ressalva}"
                                       Text="Nenhum meio foi testado &#8212; todos marcados como n&#227;o aplic&#225;veis. O local fica INVI&#193;VEL."/>

                            <TabControl x:Name="tabsMedicoes" Margin="0,0,0,14" Visibility="Collapsed"
                                        Style="{DynamicResource TabsMedicao}"
                                        ItemContainerStyle="{DynamicResource TabMedicao}"/>

                            <TextBlock x:Name="txtMetricasDesativadas" Margin="0,0,0,8" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="11" Visibility="Collapsed"
                                       Foreground="{DynamicResource Dicon.Ressalva}"/>

                            <Border Style="{DynamicResource Cartao}" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="COM A VPN (bateria da JE)" FontFamily="Consolas" FontSize="10"
                                               FontWeight="Bold" Foreground="{DynamicResource Dicon.Text2}" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="dgAvaliacaoVpn" Style="{DynamicResource GridMetricas}"
                                              MaxHeight="300" RowHeight="40" BorderThickness="0"
                                              VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="6" CanUserResize="False" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding CorFinal}" CornerRadius="2" Margin="0,3"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}"
                                                                IsReadOnly="True" Width="140"/>
                                            <DataGridTextColumn Header="Valor medido" Binding="{Binding ValorTexto}"
                                                                IsReadOnly="True" Width="110" FontFamily="Consolas"/>
                                            <DataGridTextColumn x:Name="colVpnFaixa" Header="Faixa aceit&#225;vel" Binding="{Binding Regra}"
                                                                IsReadOnly="True" Width="250" FontFamily="Consolas"/>
                                            <DataGridTemplateColumn x:Name="colVpnSugerida" Header="Sugerida" Width="90" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ClasseAutomatica}"
                                                                   Style="{DynamicResource ChipVeredito}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="colVpnClasse" Header="Classifica&#231;&#227;o" Width="150">
