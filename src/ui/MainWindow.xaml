                                        <Button x:Name="btnJaConecteiWifi" Content="J&#225; conectei pela bandeja do Windows"
                                                Style="{DynamicResource BotaoFantasma}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Dicon.Text3}"
                                               Text="Nao conectou por aqui? Use o &#237;cone de rede do Windows (perto do rel&#243;gio) e clique em &quot;J&#225; conectei pela bandeja&quot;."/>
                                    <TextBlock x:Name="txtWifiStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="cardTetheringLegado" Style="{DynamicResource Cartao}" Padding="16,14" Margin="0,12,0,0"
