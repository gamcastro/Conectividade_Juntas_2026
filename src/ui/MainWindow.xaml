                                                           Foreground="{DynamicResource Dicon.Text2}">
                                                    <Run Text="ping "/><Run x:Name="runResPing" Text="--" FontWeight="Bold"
                                                         Foreground="{DynamicResource Dicon.Text}"/><Run Text=" ms"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M1,8 Q4,3 7,8 T13,8" Stretch="Uniform" Width="14" Height="14"
                                                      Stroke="{DynamicResource Dicon.Text2}" StrokeThickness="1.6"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource Dicon.Text2}">
                                                    <Run Text="jitter "/><Run x:Name="runResJitter" Text="--" FontWeight="Bold"
                                                         Foreground="{DynamicResource Dicon.Text}"/><Run Text=" ms"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M2,3 L13,13 M13,3 L2,13" Stretch="Uniform" Width="12" Height="12"
                                                      Stroke="{DynamicResource Dicon.Text2}" StrokeThickness="1.6"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource Dicon.Text2}">
                                                    <Run Text="perda "/><Run x:Name="runResPerda" Text="--" FontWeight="Bold"
                                                         Foreground="{DynamicResource Dicon.Text}"/><Run Text=" %"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="cardConectarWifi" Style="{DynamicResource Cartao}"
                                    Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Conectar a uma rede Wi-Fi" Style="{DynamicResource SecaoTela}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtConectarWifiDica" Text="Use se o local n&#227;o tiver cabo. A senha fica gravada no perfil de Wi-Fi do Windows." TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rede (SSID)"
