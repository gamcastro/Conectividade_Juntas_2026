<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DICON - Diagnostico de Conectividade"
        Height="720" Width="980"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#111111">

    <Window.Resources>
        <x:Array x:Key="classesMetrica" Type="sys:String">
            <sys:String>viavel</sys:String>
            <sys:String>ressalva</sys:String>
            <sys:String>inviavel</sys:String>
        </x:Array>
        <x:Array x:Key="classesDecisao" Type="sys:String">
            <sys:String>viavel</sys:String>
            <sys:String>viavel_com_ressalva</sys:String>
            <sys:String>inviavel</sys:String>
        </x:Array>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BotaoMenu" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="boolVis"/>

        <!-- Tema escuro da tabela de metricas -->
        <Style x:Key="GridMetricas" TargetType="DataGrid">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#242424"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
            <Setter Property="VerticalGridLinesBrush" Value="#2A2A2A"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2B3A42"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#161616"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE TOPO (oculta no login) -->
        <Grid x:Name="barraTopo" Grid.Row="0" Background="#0D0D0D" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="imgLogoTopo" Grid.Column="0" Height="38" Margin="16,8" HorizontalAlignment="Left"/>
            <TextBlock x:Name="txtSaudacao" Grid.Column="1" VerticalAlignment="Center" Margin="14,0"
                       FontSize="14" Foreground="#CCCCCC"/>
            <Button x:Name="btnTrocarUsuario" Grid.Column="2" Content="Trocar usuario"
                    Margin="16,8" Background="#37474F" FontSize="12" Padding="10,6"/>
        </Grid>

        <!-- CONTEUDO -->
        <Grid Grid.Row="1" Margin="18">

            <!-- LOGIN -->
            <Grid x:Name="viewLogin">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
                    <Image x:Name="imgLogoLogin" Height="150" Margin="0,0,0,26"/>
                    <TextBlock Text="Selecione seu nome" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cboTecnico" Height="30" VerticalContentAlignment="Center"
                              DisplayMemberPath="nome"/>
                    <TextBlock x:Name="lblPin" Text="PIN do administrador" Foreground="#AAAAAA"
                               Margin="0,14,0,6" Visibility="Collapsed"/>
                    <PasswordBox x:Name="txtPin" Height="30" Visibility="Collapsed"/>
                    <TextBlock x:Name="txtLoginMsg" Foreground="#FF8A65" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="btnEntrar" Content="Entrar" Padding="26,8"/>
                        <Button x:Name="btnBaixarLista" Content="Baixar lista" Margin="10,0,0,0" Background="#37474F"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- HOME -->
            <Grid x:Name="viewHome" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                    <Image x:Name="imgLogoHome" Height="120" Margin="0,0,0,22"/>
                    <TextBlock x:Name="txtHomeTecnico" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="txtHomeRoteiro" FontSize="13" HorizontalAlignment="Center"
                               Foreground="#AACCEE" Margin="0,3,0,22" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="btnMenuGuia" Content="Guia de bordo" Style="{StaticResource BotaoMenu}"/>
                    <Button x:Name="btnMenuDiag" Content="Diagnostico de conectividade" Style="{StaticResource BotaoMenu}"/>
                    <Button x:Name="btnMenuAdmin" Content="Administracao" Style="{StaticResource BotaoMenu}"
                            Background="#6A1B9A" Visibility="Collapsed"/>
                    <Button x:Name="btnMenuAtualizar" Content="Atualizar dados (com internet)"
                            Style="{StaticResource BotaoMenu}" Background="#37474F"/>
                </StackPanel>
            </Grid>

            <!-- GUIA DE BORDO -->
            <Grid x:Name="viewGuia" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtGuiaTitulo" Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock x:Name="txtGuiaSub" Grid.Row="1" FontSize="12" Foreground="#AAAAAA"
                           Margin="0,4,0,10" TextWrapping="Wrap"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Trechos da viagem" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="lstTrechos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" Foreground="#DDDDDD">
                                        <Run Text="{Binding origem}"/><Run Text="  &#8594;  "/>
                                        <Run Text="{Binding destino}" FontWeight="Bold"/>
                                        <Run Text="   ("/><Run Text="{Binding distancia_km}"/><Run Text=" km &#183; "/>
                                        <Run Text="{Binding tempo}"/><Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Locais para diagnostico" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,16,0,6"/>
                        <ItemsControl x:Name="lstGuiaJuntas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                                            Margin="0,0,0,10" Padding="10">
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,6" Foreground="#EEEEEE">
                                                <Run Text="ZE "/><Run Text="{Binding zona_eleitoral}"/>
                                                <Run Text="  &#183;  "/><Run Text="{Binding municipio_termo}" FontWeight="Bold"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding locais}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Foreground="#DDDDDD" TextWrapping="Wrap">
                                                                    <Run Text="{Binding tipo_rotulo}" Foreground="#8BC48B"/>
                                                                    <Run Text="  &#8212;  "/><Run Text="{Binding nome}" FontWeight="Bold"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding endereco}" Foreground="#999999"
                                                                           FontSize="11" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding tipo_internet}" Foreground="#7FA8C9" FontSize="11"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Rodar diagnostico" Tag="{Binding}"
                                                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    FontSize="12" Padding="10,6"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="txtGuiaSemJunta" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="btnGuiaVoltar" Grid.Row="3" Content="Voltar" HorizontalAlignment="Left"
                        Margin="0,12,0,0" Background="#37474F"/>
            </Grid>

            <!-- DIAGNOSTICO -->
            <Grid x:Name="viewDiag" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="110"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Junta Especial:" Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="cboJunta" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                              Height="28" VerticalContentAlignment="Center" DisplayMemberPath="Rotulo"/>
                    <Button x:Name="btnAtualizar" Grid.Row="0" Grid.Column="2" Content="Atualizar lista"
                            Margin="8,0,0,6" Background="#37474F" FontSize="13" Padding="12,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Local:" Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cboLocal" Grid.Row="1" Grid.Column="1"
                              Height="28" VerticalContentAlignment="Center" DisplayMemberPath="Rotulo"/>
                    <Button x:Name="btnRodar" Grid.Row="1" Grid.Column="2" Content="Rodar diagnostico"
                            Margin="8,0,0,0"/>
                </Grid>

                <ProgressBar x:Name="prgProgresso" Grid.Row="1" Height="6" Margin="0,12"
                             Minimum="0" Maximum="100" IsIndeterminate="False"/>

                <Border Grid.Row="2" Background="#000000" BorderBrush="#333333" BorderThickness="1">
                    <ListBox x:Name="lstLog" Background="Transparent" BorderThickness="0"
                             Foreground="#DDDDDD" FontFamily="Consolas" FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Hora}" Foreground="#777777" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Texto}" Foreground="{Binding Cor}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <DataGrid x:Name="dgAvaliacao" Grid.Row="3" Margin="0,12,0,0" MaxHeight="260"
                          Style="{StaticResource GridMetricas}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="38"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Métrica" Binding="{Binding Rotulo}" IsReadOnly="True" Width="130"/>
                        <DataGridTextColumn Header="Valor medido" Binding="{Binding ValorTexto}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="Faixa aceitável" Binding="{Binding Regra}" IsReadOnly="True" Width="250"/>
                        <DataGridTextColumn Header="Sugerida" Binding="{Binding ClasseAutomatica}" IsReadOnly="True" Width="90"/>
                        <DataGridTemplateColumn Header="Classificação" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="2" VerticalContentAlignment="Center"
                                              ItemsSource="{StaticResource classesMetrica}"
                                              SelectedItem="{Binding ClasseFinal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Motivo do ajuste" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Margin="2" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalContentAlignment="Center"
                                             Background="#1B1B1B" Foreground="#EEEEEE" BorderBrush="#444444"
                                             Visibility="{Binding Ajustada, Converter={StaticResource boolVis}}"
                                             Text="{Binding Justificativa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Decisão final:" Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"/>
                    <ComboBox x:Name="cboDecisaoFinal" Grid.Column="1" Width="200" Height="28"
                              VerticalContentAlignment="Center" ItemsSource="{StaticResource classesDecisao}"/>
                    <TextBlock x:Name="lblDecisaoRecalc" Grid.Column="2" Foreground="#8BC48B"
                               VerticalAlignment="Center" Margin="12,0" FontSize="12"/>
                    <TextBlock x:Name="lblJustDecisao" Grid.Column="3" Text="Motivo do ajuste:" Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="8,0,6,0" FontSize="13" Visibility="Collapsed"/>
                    <TextBox x:Name="txtJustDecisao" Grid.Column="4" Height="28" VerticalContentAlignment="Center"
                             Background="#1B1B1B" Foreground="#EEEEEE" BorderBrush="#444444"
                             Visibility="Collapsed"/>
                </Grid>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="btnSalvarResultado" Content="Salvar resultado" Padding="22,8"
                            Background="#2E7D32" IsEnabled="False"/>
                    <Button x:Name="btnDiagVoltar" Content="Voltar" Margin="10,0,0,0" Background="#37474F"/>
                </StackPanel>
            </Grid>

            <!-- ADMIN - limiares -->
            <Grid x:Name="viewAdmin" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Administração — limiares de decisão" FontSize="18"
                           FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Grid.Row="1" Text="Valores que definem viável / ressalva / inviável por métrica. Salvos na planilha de configuração e usados por todos os notebooks."
                           Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>

                <DataGrid x:Name="dgLimiares" Grid.Row="2" Style="{StaticResource GridMetricas}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="40" MaxHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Métrica" Binding="{Binding Rotulo}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="Unidade" Binding="{Binding Unidade}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Direção" Binding="{Binding DirecaoTexto}" IsReadOnly="True" Width="130"/>
                        <DataGridTemplateColumn Header="Ideal (viável até/desde)" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Margin="2" VerticalContentAlignment="Center"
                                             Background="#1B1B1B" Foreground="#EEEEEE" BorderBrush="#444444"
                                             Text="{Binding LimiarViavel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ressalva (limite)" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Margin="2" VerticalContentAlignment="Center"
                                             Background="#1B1B1B" Foreground="#EEEEEE" BorderBrush="#444444"
                                             Text="{Binding LimiarRessalva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PIN do administrador:" Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <PasswordBox x:Name="txtPinAdmin" Grid.Column="1" Width="140" Height="28"/>
                    <Button x:Name="btnSalvarLimiares" Grid.Column="2" Content="Salvar limiares"
                            Margin="12,0,0,0" Background="#2E7D32" Padding="18,8"/>
                    <Button x:Name="btnRecarregarLimiares" Grid.Column="3" Content="Recarregar"
                            Margin="8,0,0,0" Background="#37474F"/>
                    <TextBlock x:Name="lblAdminMsg" Grid.Column="4" VerticalAlignment="Center"
                               Margin="14,0,0,0" TextWrapping="Wrap"/>
                </Grid>

                <Button x:Name="btnAdminVoltar" Grid.Row="4" Content="Voltar" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="0,14,0,0" Background="#37474F"/>
            </Grid>

        </Grid>
    </Grid>
</Window>
