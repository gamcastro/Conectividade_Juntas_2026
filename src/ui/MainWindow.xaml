                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="COM VPN Ideal" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         Text="{Binding ComVpnIdeal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="COM VPN Limite" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         Text="{Binding ComVpnLimite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
