                                                    <DataTemplate>
                                                        <TextBox Margin="2" TextWrapping="Wrap" AcceptsReturn="True"
                                                                 VerticalContentAlignment="Center"
                                                                 Visibility="{Binding Ajustada, Converter={StaticResource boolVis}}"
                                                                 Text="{Binding Justificativa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="cardAvaliacaoRl" Style="{DynamicResource Cartao}" Padding="14,12"
                                    Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="SEM VPN CONECTADA &#8212; TESTE DE VELOCIDADE"
                                               FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Dicon.Text2}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtRedeLocalNota" TextWrapping="Wrap" FontSize="11"
                                               Margin="0,0,0,8" Foreground="{DynamicResource Dicon.Text3}"/>
                                    <DataGrid x:Name="dgAvaliacaoRl" Style="{DynamicResource GridMetricas}"
                                              MaxHeight="260" RowHeight="40" BorderThickness="0"
                                              VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="6" CanUserResize="False" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding CorFinal}" CornerRadius="2" Margin="0,3"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}"
                                                                IsReadOnly="True" Width="140"/>
                                            <DataGridTextColumn Header="Valor medido" Binding="{Binding ValorTexto}"
                                                                IsReadOnly="True" Width="110" FontFamily="Consolas"/>
                                            <DataGridTextColumn x:Name="colRlFaixa" Header="Faixa aceit&#225;vel" Binding="{Binding Regra}"
                                                                IsReadOnly="True" Width="250" FontFamily="Consolas"/>
                                            <DataGridTemplateColumn x:Name="colRlSugerida" Header="Sugerida" Width="90" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ClasseAutomatica}"
                                                                   Style="{DynamicResource ChipVeredito}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="colRlClasse" Header="Classifica&#231;&#227;o" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox Margin="2" VerticalContentAlignment="Center"
                                                                  ItemsSource="{StaticResource classesMetrica}"
                                                                  SelectedItem="{Binding ClasseFinal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="colRlMotivo" Header="Motivo do ajuste" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Margin="2" TextWrapping="Wrap" AcceptsReturn="True"
                                                                 VerticalContentAlignment="Center"
                                                                 Visibility="{Binding Ajustada, Converter={StaticResource boolVis}}"
                                                                 Text="{Binding Justificativa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 5: recomendacao final -->
                    <ScrollViewer x:Name="stepDecisao" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{DynamicResource Cartao}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="barraDecisaoStripe" Grid.Column="0" Width="4"
                                            CornerRadius="2" Margin="0,0,14,0"
                                            Background="{DynamicResource Dicon.Text3}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="RECOMENDA&#199;&#195;O FINAL" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}"/>
                                        <TextBlock x:Name="txtDecisaoPalavra" Text="&#8212;"
                                                   FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold"
                                                   FontSize="20" Foreground="{DynamicResource Dicon.Text}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="cboDecisaoFinal" Grid.Column="2" Width="200" MinHeight="32"
                                              VerticalContentAlignment="Center" VerticalAlignment="Center"
                                              ItemsSource="{StaticResource classesDecisao}"/>
                                    <TextBlock x:Name="lblDecisaoRecalc" Grid.Column="3"
                                               Foreground="{DynamicResource Dicon.Text3}"
                                               VerticalAlignment="Center" Margin="14,0" FontFamily="Consolas"
                                               FontSize="11"/>
                                    <TextBlock x:Name="lblJustDecisao" Grid.Column="4" Text="Motivo do ajuste:"
                                               Foreground="{DynamicResource Dicon.Text3}"
                                               VerticalAlignment="Center" Margin="6,0,6,0" FontSize="12"
                                               Visibility="Collapsed"/>
                                    <TextBox x:Name="txtJustDecisao" Grid.Column="5" MinHeight="32"
                                             VerticalContentAlignment="Center" VerticalAlignment="Center"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{DynamicResource SubtituloTela}" Margin="0,12,0,0"
                                       Text="A recomenda&#231;&#227;o final vem do pior caso entre as m&#233;tricas. Voc&#234; pode sobrescrev&#234;-la aqui &#8212; nesse caso, informe o motivo."/>

                            <!-- conexao recomendada para o local (multi-meio) -->
                            <Border Style="{DynamicResource Cartao}" Padding="16,14" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="CONEX&#195;O RECOMENDADA PARA ESTE LOCAL"
                                               FontFamily="Consolas" FontSize="9"
                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                    <ComboBox x:Name="cboConexaoRec" Width="380" MinHeight="32" Margin="0,6,0,0"
                                              HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="lblRecContexto" Margin="0,8,0,0" TextWrapping="Wrap"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource Dicon.Text2}"/>
                                    <TextBlock Text="Motivo da recomenda&#231;&#227;o (obrigat&#243;rio):" Margin="0,12,0,4"
                                               Foreground="{DynamicResource Dicon.Text3}" FontSize="12"/>
                                    <TextBox x:Name="txtMotivoRec" MinHeight="60" TextWrapping="Wrap"
                                             AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Medi&#231;&#245;es feitas neste local"
                                       Style="{DynamicResource SecaoTela}" Margin="0,16,0,6"/>
                            <DataGrid x:Name="dgMedicoes" Style="{DynamicResource GridMetricas}"
                                      MaxHeight="220" RowHeight="34" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserResizeRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Meio" Binding="{Binding Meio}" Width="230"/>
                                    <DataGridTextColumn Header="Rede Local" Binding="{Binding RedeLocal}"
                                                        Width="130" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="VPN" Binding="{Binding Vpn}" Width="90"/>
                                    <DataGridTextColumn Header="Download VPN" Binding="{Binding VpnDown}"
                                                        Width="120" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="Veredito" Binding="{Binding Veredito}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PASSO 6: conclusao / exportar -->
                    <ScrollViewer x:Name="stepFim" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <Border Style="{DynamicResource Cartao}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="Diagn&#243;stico conclu&#237;do" Style="{DynamicResource SecaoTela}"/>
                                <TextBlock x:Name="txtFimLocal" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="DECIS&#195;O FINAL" FontFamily="Consolas" FontSize="9"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Dicon.Text3}"/>
                                    <TextBlock x:Name="txtFimVeredito" Text="&#8212;" Margin="10,0,0,0"
                                               FontFamily="{DynamicResource Dicon.Display}" FontWeight="Bold"
                                               FontSize="20" Foreground="{DynamicResource Dicon.Text}"/>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Dicon.Text3}">O resultado fica salvo
                                    neste computador. <Run FontWeight="Bold">Transmitir</Run> envia agora ao
                                    painel (com internet); sen&#227;o ele vai junto no pr&#243;ximo
                                    "Atualizar dados" / "Reenviar".</TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="btnSalvarResultado" Content="Salvar resultado"
                                            Style="{DynamicResource BotaoSucesso}" IsEnabled="False"/>
                                    <Button x:Name="btnTransmitirResultado" Content="Transmitir resultado"
                                            Style="{DynamicResource BotaoPrimario}" Margin="10,0,0,0"
                                            IsEnabled="False"/>
                                    <Button x:Name="btnExportarPdf" Content="Exportar relat&#243;rio (PDF)"
                                            Style="{DynamicResource BotaoSecundario}" Margin="10,0,0,0"
                                            IsEnabled="False"/>
                                    <mah:ProgressRing x:Name="ringFim" Width="18" Height="18" Margin="12,0,0,0"
                                                      IsActive="False" Visibility="Collapsed"
                                                      Foreground="{DynamicResource Dicon.Accent}"/>
                                </StackPanel>
                                <TextBlock x:Name="txtFimStatus" Margin="0,12,0,0" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource Dicon.Text2}"/>

                                <Border Style="{DynamicResource Faixa}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="A&#199;&#213;ES" FontFamily="Consolas" FontSize="9"
                                                   Foreground="{DynamicResource Dicon.Text3}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimSalvar" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Salvar resultado" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimTransmitir" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Transmitir resultado" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock x:Name="chkFimExportar" Text="&#10007;" Width="22"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource Dicon.Inviavel}"/>
                                            <TextBlock Text="Exportar relat&#243;rio (PDF)" FontSize="12"
                                                       Foreground="{DynamicResource Dicon.Text2}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="btnFinalizarDiag" Margin="0,20,0,0" HorizontalAlignment="Left"
                                        Style="{DynamicResource BotaoPrimario}" IsEnabled="False" Padding="18,9">
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Stroke="{DynamicResource Dicon.Deep}" StrokeThickness="1.6"
                                                  Data="M3,1 L3,17"/>
                                            <Path Stroke="{DynamicResource Dicon.Deep}" StrokeThickness="1.4"
                                                  Fill="{DynamicResource Dicon.Deep}"
                                                  Data="M4,2 L16,2 L16,10 L4,10 Z M4,2 L10,2 L10,6 L4,6 Z M10,6 L16,6 L16,10 L10,10 Z"/>
                                        </Canvas>
                                        <TextBlock Text="Finalizar" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="txtFimFinalizarDica" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Dicon.Text3}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                </Grid>

                <!-- rodape: navegacao do assistente -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnDiagVoltar" Grid.Column="0" Content="Sair do assistente"
                            Style="{DynamicResource BotaoFantasma}"/>
                    <Button x:Name="btnWizVoltar" Grid.Column="2" Content="Voltar"
                            Style="{DynamicResource BotaoSecundario}" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button x:Name="btnWizProximo" Grid.Column="3" Content="Pr&#243;ximo"
                            Style="{DynamicResource BotaoPrimario}"/>
                </Grid>
            </Grid>

            <!-- ===== ADMIN (LIMIARES) ===== -->
            <Grid x:Name="viewAdmin" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Administra&#231;&#227;o &#8212; limiares de decis&#227;o"
                           Style="{DynamicResource TituloTela}"/>
                <TextBlock Grid.Row="1"
                           Text="Vi&#225;vel / ressalva / invi&#225;vel por MEIO (LAN / Wi-Fi do local / Celular) e por cen&#225;rio (SEM VPN / COM VPN). SEM VPN tem como piso os valores de refer&#234;ncia da ANATEL. COM VPN = SEM VPN + or&#231;amento da VPN. O Wi-Fi do local herda da LAN + folga. &quot;Na bateria&quot; &#233; por meio &#215; cen&#225;rio &#215; m&#233;trica. Salvo na planilha de configura&#231;&#227;o e usado por todos os computadores."
                           Style="{DynamicResource SubtituloTela}" Margin="0,6,0,12"/>

                <StackPanel Grid.Row="2">
                    <Border Style="{DynamicResource Cartao}" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Modo de avalia&#231;&#227;o" Style="{DynamicResource SecaoTela}" Margin="0,0,0,4"/>
                            <TextBlock Text="Define o que o assistente e o relat&#243;rio mostram. Salvo junto com os limiares (mesmo PIN)."
                                       FontSize="11" Foreground="{DynamicResource Dicon.Text3}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <RadioButton x:Name="rbModoMedicao" GroupName="modoAval" Margin="0,3"
                                         Content="Medi&#231;&#227;o &#8212; s&#243; os valores medidos por meio (LAN / Wi-Fi / Celular). Assistente de 5 passos, sem ju&#237;zo de viabilidade. (padr&#227;o)"/>
                            <RadioButton x:Name="rbModoReferencia" GroupName="modoAval" Margin="0,3"
                                         Content="Refer&#234;ncia &#8212; valores e a faixa aceit&#225;vel lado a lado, mas nada &#233; reprovado."/>
                            <RadioButton x:Name="rbModoCompleto" GroupName="modoAval" Margin="0,3"
                                         Content="Viabilidade completa &#8212; classifica vi&#225;vel/ressalva/invi&#225;vel, recomenda o meio, Painel de Viabilidade. Assistente de 6 passos."/>
                        </StackPanel>
                    </Border>
                    <TabControl x:Name="tabLimiares" MinHeight="230">
                        <TabItem Header="LAN (rede cabeada)">
                            <Border Style="{DynamicResource Cartao}" Padding="2">
                                <DataGrid x:Name="dgLimLan" Style="{DynamicResource GridMetricas}"
                                          BorderThickness="0" RowHeight="40" MaxHeight="280"
                                          CanUserResizeRows="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Bat. SEM VPN" Width="92">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <CheckBox Margin="10,0,0,0" VerticalAlignment="Center"
                                                          IsEnabled="{Binding SemVpnVisivel}"
                                                          IsChecked="{Binding SemVpnAtivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Bat. COM VPN" Width="92">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <CheckBox Margin="10,0,0,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding ComVpnAtivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}" IsReadOnly="True" Width="130"/>
                                        <DataGridTextColumn Header="Un." Binding="{Binding Unidade}" IsReadOnly="True" Width="52" FontFamily="Consolas"/>
                                        <DataGridTemplateColumn Header="SEM VPN Ideal" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         IsEnabled="{Binding SemVpnVisivel}"
                                                         Text="{Binding SemVpnIdeal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="SEM VPN Limite" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         IsEnabled="{Binding SemVpnVisivel}"
                                                         Text="{Binding SemVpnLimite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="COM VPN Ideal" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         Text="{Binding ComVpnIdeal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="COM VPN Limite" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         Text="{Binding ComVpnLimite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </TabItem>

                        <TabItem Header="Wi-Fi do local">
                            <StackPanel>
                                <TextBlock Text="Herda da LAN + folga (aditiva p/ ms/%/s; percentual p/ banda). Ideal/Limite s&#227;o s&#243; leitura &#8212; edite a Folga e o &quot;Na bateria&quot;."
                                           FontSize="11" Foreground="{DynamicResource Dicon.Text3}" TextWrapping="Wrap" Margin="4,2,4,6"/>
                                <Border Style="{DynamicResource Cartao}" Padding="2">
                                    <DataGrid x:Name="dgLimWifi" Style="{DynamicResource GridMetricas}"
                                              BorderThickness="0" RowHeight="40" MaxHeight="260"
                                              CanUserResizeRows="False" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Bat. SEM VPN" Width="92">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <CheckBox Margin="10,0,0,0" VerticalAlignment="Center"
                                                              IsEnabled="{Binding SemVpnVisivel}"
                                                              IsChecked="{Binding SemVpnAtivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Bat. COM VPN" Width="92">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <CheckBox Margin="10,0,0,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding ComVpnAtivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}" IsReadOnly="True" Width="130"/>
                                            <DataGridTextColumn Header="Un." Binding="{Binding Unidade}" IsReadOnly="True" Width="52" FontFamily="Consolas"/>
                                            <DataGridTemplateColumn Header="Folga" Width="90">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                             Text="{Binding Folga, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="SEM VPN Ideal" IsReadOnly="True" Width="*" FontFamily="Consolas"
                                                                Binding="{Binding SemVpnIdeal}"/>
                                            <DataGridTextColumn Header="SEM VPN Limite" IsReadOnly="True" Width="*" FontFamily="Consolas"
                                                                Binding="{Binding SemVpnLimite}"/>
                                            <DataGridTextColumn Header="COM VPN Ideal" IsReadOnly="True" Width="*" FontFamily="Consolas"
                                                                Binding="{Binding ComVpnIdeal}"/>
                                            <DataGridTextColumn Header="COM VPN Limite" IsReadOnly="True" Width="*" FontFamily="Consolas"
                                                                Binding="{Binding ComVpnLimite}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Celular roteado">
                            <Border Style="{DynamicResource Cartao}" Padding="2">
                                <DataGrid x:Name="dgLimCel" Style="{DynamicResource GridMetricas}"
                                          BorderThickness="0" RowHeight="40" MaxHeight="280"
                                          CanUserResizeRows="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Bat. SEM VPN" Width="92">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <CheckBox Margin="10,0,0,0" VerticalAlignment="Center"
                                                          IsEnabled="{Binding SemVpnVisivel}"
                                                          IsChecked="{Binding SemVpnAtivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Bat. COM VPN" Width="92">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <CheckBox Margin="10,0,0,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding ComVpnAtivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="M&#233;trica" Binding="{Binding Rotulo}" IsReadOnly="True" Width="130"/>
                                        <DataGridTextColumn Header="Un." Binding="{Binding Unidade}" IsReadOnly="True" Width="52" FontFamily="Consolas"/>
                                        <DataGridTemplateColumn Header="SEM VPN Ideal" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         IsEnabled="{Binding SemVpnVisivel}"
                                                         Text="{Binding SemVpnIdeal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="SEM VPN Limite" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBox Margin="3" VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         IsEnabled="{Binding SemVpnVisivel}"
